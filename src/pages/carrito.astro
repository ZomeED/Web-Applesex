---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Mi Carrito de Compra" 
  description="Revisa los productos seleccionados en tu carrito de Applesex. Finaliza tu compra de forma discreta y segura."
>
  <section style="padding: 60px 0 100px 0; min-height: 70vh;">
    <div class="container">
      
      <h1 style="font-size: 2.2rem; margin-bottom: 40px; border-bottom: 1px solid var(--border-color); padding-bottom: 20px;">
        🛒 Tu Carrito de Compra
      </h1>

      <div id="cart-container" style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px; align-items: start;">
        
        <!-- Listado de Productos en el carrito -->
        <div class="glass" style="padding: 24px; border-radius: var(--border-radius);">
          <div id="cart-items-list" style="display: flex; flex-direction: column; gap: 24px;">
            <!-- Se inyectará por JS -->
            <p style="color: var(--text-secondary); text-align: center; padding: 40px 0;">Cargando tu selección...</p>
          </div>
        </div>

        <!-- Resumen de Compra y Formulario de Envío -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
          
          <!-- Método de Entrega -->
          <div class="glass" style="padding: 24px; border-radius: var(--border-radius);">
            <h3 style="font-size: 1.2rem; margin-bottom: 20px; color: var(--accent);">Método de Entrega</h3>
            <div style="display: flex; flex-direction: column; gap: 12px;">
              
              <label style="display: flex; gap: 12px; align-items: center; cursor: pointer; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; background: #ffffff;">
                <input type="radio" name="delivery_method" value="recogida" checked style="accent-color: var(--primary);" />
                <div>
                  <div style="font-weight: 600;">Recogida Gratis en Tienda (Churra, Murcia)</div>
                  <div style="font-size: 0.8rem; color: var(--text-secondary);">Listo en 2 horas. Te avisamos por WhatsApp</div>
                </div>
              </label>

              <label style="display: flex; gap: 12px; align-items: center; cursor: pointer; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; background: #ffffff;">
                <input type="radio" name="delivery_method" value="envio" style="accent-color: var(--primary);" />
                <div>
                  <div style="font-weight: 600;">Envío a Domicilio (4.95€)</div>
                  <div style="font-size: 0.8rem; color: var(--text-secondary);">24h-48h discreto. Gratis en compras > 50€</div>
                </div>
              </label>

            </div>
          </div>

          <!-- Resumen Económico -->
          <div class="glass" style="padding: 24px; border-radius: var(--border-radius); background: #ffffff; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
            <h3 style="font-size: 1.2rem; margin-bottom: 20px; color: var(--primary);">Resumen del Pedido</h3>
            
            <div style="display: flex; flex-direction: column; gap: 12px; font-size: 0.95rem; border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 16px;">
              <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-secondary);">Subtotal:</span>
                <span id="summary-subtotal">0.00€</span>
              </div>
              <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-secondary);">Gastos de Envío:</span>
                <span id="summary-delivery">0.00€</span>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: 700; margin-bottom: 24px;">
              <span>Total:</span>
              <span id="summary-total" style="color: var(--primary);">0.00€</span>
            </div>

            <!-- Formulario de datos mínimos para el pago seguro -->
            <form id="checkout-form" style="display: flex; flex-direction: column; gap: 16px;">
              <div>
                <label for="cust-name" style="display: block; font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px;">Nombre Completo</label>
                <input type="text" id="cust-name" required style="width: 100%; padding: 12px; background: #f7f7fa; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-family: var(--font-body);" placeholder="Juan Pérez" />
              </div>

              <div>
                <label for="cust-email" style="display: block; font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px;">Correo Electrónico</label>
                <input type="email" id="cust-email" required style="width: 100%; padding: 12px; background: #f7f7fa; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-family: var(--font-body);" placeholder="juan@gmail.com" />
              </div>

              <div id="shipping-address-fields" style="display: none; flex-direction: column; gap: 16px;">
                <div>
                  <label for="cust-address" style="display: block; font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px;">Dirección de Envío</label>
                  <input type="text" id="cust-address" style="width: 100%; padding: 12px; background: #f7f7fa; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary);" placeholder="Calle Mayor 12, 3ºB" />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                  <div>
                    <label for="cust-city" style="display: block; font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px;">Localidad</label>
                    <input type="text" id="cust-city" style="width: 100%; padding: 12px; background: #f7f7fa; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary);" placeholder="Murcia" />
                  </div>
                  <div>
                    <label for="cust-zip" style="display: block; font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px;">Cód. Postal</label>
                    <input type="text" id="cust-zip" style="width: 100%; padding: 12px; background: #f7f7fa; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary);" placeholder="30110" />
                  </div>
                </div>
              </div>

              <button type="submit" class="btn btn-primary" style="width: 100%; font-size: 1.05rem; padding: 14px; margin-top: 10px;">
                Proceder al Pago Seguro
              </button>
            </form>

          </div>

        </div>

      </div>

      <!-- Carrito Vacío UI -->
      <div id="cart-empty-view" style="display: none; text-align: center; padding: 80px 0;">
        <div style="background: rgba(216, 75, 140, 0.08); width: 100px; height: 100px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 30px auto; color: var(--primary);">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </div>
        <h2 style="font-size: 1.8rem; margin-bottom: 16px;">Tu carrito está vacío</h2>
        <p style="color: var(--text-secondary); margin-bottom: 32px; max-width: 400px; margin-left: auto; margin-right: auto;">
          Parece que aún no has añadido ningún producto erótico o de bienestar a tu carrito.
        </p>
        <a href="/#catalogo" class="btn btn-primary">Volver al Catálogo</a>
      </div>

    </div>
  </section>

  <script>
    // Lógica dinámica del Carrito
    let cart = [];

    function loadCart() {
      cart = JSON.parse(localStorage.getItem('cart') || '[]');
      renderCart();
    }

    function saveCart() {
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));
      renderCart();
    }

    function renderCart() {
      const listEl = document.getElementById('cart-items-list');
      const containerEl = document.getElementById('cart-container');
      const emptyEl = document.getElementById('cart-empty-view');

      if (!listEl || !containerEl || !emptyEl) return;

      if (cart.length === 0) {
        containerEl.style.display = 'none';
        emptyEl.style.display = 'block';
        return;
      }

      containerEl.style.display = 'grid';
      emptyEl.style.display = 'none';

      // Renderizar listado de productos
      listEl.innerHTML = cart.map(item => `
        <div style="display: flex; gap: 20px; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 20px; flex-wrap: wrap;">
          <img src="${item.image}" alt="${item.name}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-color); background: #f7f7fa;" />
          
          <div style="flex-grow: 1; min-width: 150px;">
            <h4 style="font-size: 1.05rem; margin-bottom: 4px; font-weight: 700;">${item.name}</h4>
            ${item.variant ? `<span style="display: block; font-size: 0.82rem; color: var(--primary); font-weight: 600; margin-bottom: 4px;">Aroma / Variante: ${item.variant}</span>` : ''}
            <span style="color: var(--primary); font-weight: 700; font-size: 0.95rem;">${item.price.toFixed(2)}€</span>
          </div>

          <!-- Modificador de cantidad -->
          <div style="display: flex; align-items: center; border: 1px solid var(--border-color); border-radius: 6px; overflow: hidden; background: #f7f7fa;">
            <button class="qty-btn dec-btn" data-id="${item.id}" style="background: transparent; border: none; color: var(--text-primary); padding: 8px 12px; cursor: pointer; font-weight: bold;">-</button>
            <span style="padding: 0 12px; font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">${item.quantity}</span>
            <button class="qty-btn inc-btn" data-id="${item.id}" style="background: transparent; border: none; color: var(--text-primary); padding: 8px 12px; cursor: pointer; font-weight: bold;">+</button>
          </div>

          <!-- Total de línea -->
          <div style="min-width: 80px; text-align: right;">
            <span style="font-weight: 700; font-size: 1.1rem; color: var(--text-primary);">${(item.price * item.quantity).toFixed(2)}€</span>
          </div>

          <!-- Eliminar -->
          <button class="remove-btn" data-id="${item.id}" style="background: transparent; border: none; color: var(--error); cursor: pointer; padding: 8px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </button>
        </div>
      `).join('');

      // Asociar eventos a los botones generados
      listEl.querySelectorAll('.inc-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
          const item = cart.find(i => i.id === id);
          if (item) {
            item.quantity += 1;
            saveCart();
          }
        });
      });

      listEl.querySelectorAll('.dec-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
          const item = cart.find(i => i.id === id);
          if (item && item.quantity > 1) {
            item.quantity -= 1;
            saveCart();
          }
        });
      });

      listEl.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
          cart = cart.filter(i => i.id !== id);
          saveCart();
        });
      });

      calculateTotals();
    }

    function calculateTotals() {
      const subtotal = cart.reduce((total, item) => total + (item.price * item.quantity), 0);
      const deliveryMethod = (document.querySelector('input[name="delivery_method"]:checked') as HTMLInputElement)?.value;
      
      let shippingCost = 0;
      if (deliveryMethod === 'envio') {
        shippingCost = subtotal >= 50 ? 0 : 4.95;
      }

      const total = subtotal + shippingCost;

      const subtotalEl = document.getElementById('summary-subtotal');
      const deliveryEl = document.getElementById('summary-delivery');
      const totalEl = document.getElementById('summary-total');

      if (subtotalEl) subtotalEl.textContent = `${subtotal.toFixed(2)}€`;
      if (deliveryEl) deliveryEl.textContent = shippingCost === 0 ? 'Gratis' : `${shippingCost.toFixed(2)}€`;
      if (totalEl) totalEl.textContent = `${total.toFixed(2)}€`;
    }

    // Escuchar el cambio en el tipo de envío
    document.querySelectorAll('input[name="delivery_method"]').forEach(radio => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const addressFields = document.getElementById('shipping-address-fields');
        
        if (addressFields) {
          if (val === 'envio') {
            addressFields.style.display = 'flex';
            addressFields.querySelectorAll('input').forEach(i => i.required = true);
          } else {
            addressFields.style.display = 'none';
            addressFields.querySelectorAll('input').forEach(i => i.required = false);
          }
        }
        calculateTotals();
      });
    });

    // Lógica para enviar el checkout al endpoint de la API
    const form = document.getElementById('checkout-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const name = (document.getElementById('cust-name') as HTMLInputElement).value;
        const email = (document.getElementById('cust-email') as HTMLInputElement).value;
        const deliveryMethod = (document.querySelector('input[name="delivery_method"]:checked') as HTMLInputElement).value;

        let address = {};
        if (deliveryMethod === 'envio') {
          address = {
            addressLine1: (document.getElementById('cust-address') as HTMLInputElement).value,
            city: (document.getElementById('cust-city') as HTMLInputElement).value,
            postalCode: (document.getElementById('cust-zip') as HTMLInputElement).value,
          };
        }

        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Procesando con Stripe...';

        try {
          // Petición a nuestra API serverless local
          const response = await fetch('/api/checkout', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              name,
              email,
              deliveryMethod,
              address,
              items: cart.map(i => ({ id: i.id, quantity: i.quantity }))
            })
          });

          const data = await response.json();
          if (data.url) {
            // Vaciar carrito tras la redirección exitosa de Stripe
            // (En un entorno de producción es aconsejable vaciar tras volver de Stripe exitosamente)
            localStorage.removeItem('cart');
            window.dispatchEvent(new Event('cart-updated'));
            // Redirigir a Stripe Checkout
            window.location.href = data.url;
          } else {
            alert('Error en pasarela: ' + (data.error || 'Inténtalo de nuevo.'));
            submitBtn.disabled = false;
            submitBtn.textContent = 'Proceder al Pago Seguro';
          }
        } catch (err) {
          console.error(err);
          alert('Hubo un error de conexión con el servidor.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Proceder al Pago Seguro';
        }
      });
    }

    // Cargar al inicializar la página
    loadCart();
  </script>
</Layout>
