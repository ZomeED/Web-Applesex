    @media (max-width: 480px) {
      .products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }
      
      .product-card {
        border-radius: 12px;
      }
      
      .product-image-container {
        padding: 8px;
      }
      
      .product-card-body {
        padding: 10px !important;
      }
      
      .product-title-link {
        font-size: 0.88rem !important;
        margin-bottom: 4px !important;
        line-height: 1.2 !important;
        height: 2.4em; /* Limitar para alinear cuadrícula */
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
      }
      
      .product-card-body p {
        display: none !important;
      }
      
      .product-card-footer {
        flex-direction: column;
        align-items: stretch !important;
        gap: 6px;
        padding-top: 6px !important;
        border-top: 1px solid var(--border-color);
      }
      
      .product-card-footer > div {
        justify-content: center;
        width: 100%;
      }
      
      .product-card-footer .add-to-cart-btn {
        width: 100%;
        padding: 6px 8px !important;
        font-size: 0.78rem !important;
        min-height: 32px;
        border-radius: 8px;
      }

      .category-filter-chips {
        gap: 6px !important;
      }
      
      .grid-cat-btn {
        padding: 6px 12px !important;
        font-size: 0.78rem !important;
        min-height: 32px !important;
      }

      .subcategory-filter-chips {
        gap: 6px !important;
        padding: 8px 4px 4px 4px !important;
      }

      .grid-sub-cat-btn {
        padding: 5px 10px !important;
        font-size: 0.74rem !important;
        min-height: 28px !important;
      }
    }

    @media (max-width: 768px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 40px;
        text-align: center;
      }
      .hero-grid > div {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .catalogue-toolbar {
        padding: 16px;
      }
    }

    /* Paginación del catálogo */
    .pagination-container {
      margin-top: 40px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    
    .pagination-btn {
      background: #ffffff;
      border: 1px solid var(--border-color);
      color: var(--text-primary);
      width: 40px;
      height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      font-family: var(--font-title);
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: var(--transition-smooth);
      user-select: none;
    }
    
    .pagination-btn:hover:not(:disabled) {
      border-color: var(--primary);
      color: var(--primary);
      background-color: #fcf0f5;
      transform: translateY(-1px);
    }
    
    .pagination-btn.active {
      background: linear-gradient(135deg, #e45b9a, #c43b7a);
      color: #ffffff;
      border-color: transparent;
      box-shadow: var(--shadow-glow);
    }
    
    .pagination-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      background: #f7f7fa;
    }
    
    .pagination-arrow {
      font-size: 1.1rem;
      font-weight: 700;
    }

    .pagination-ellipsis {
      color: #727586;
      width: 40px;
      height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 1rem;
      user-select: none;
    }
  </style>

  <!-- Script del cliente para filtrado en tiempo real de los 30 productos -->
  <script define:vars={{ initialProducts: allProducts }}>
    // Helper para formatear categorías a Camel Case
    function formatCategoryName(str) {
      if (!str) return '';
      const words = str.toLowerCase().split(' ');
      const formattedWords = words.map((word, index) => {
        const lowerWords = ['y', 'e', 'o', 'u', 'de', 'del', 'con', 'para', 'en'];
        if (lowerWords.includes(word) && index > 0) {
          return word;
        }
        return word.charAt(0).toUpperCase() + word.slice(1);
      });
      return formattedWords.join(' ');
    }

    // Algoritmo de distancia de Levenshtein para tolerancia a erratas
    function levenshtein(a, b) {
      const matrix = [];
      for (let i = 0; i <= b.length; i++) matrix[i] = [i];
      for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
      for (let i = 1; i <= b.length; i++) {
        for (let j = 1; j <= a.length; j++) {
          if (b.charAt(i - 1) === a.charAt(j - 1)) {
            matrix[i][j] = matrix[i - 1][j - 1];
          } else {
            matrix[i][j] = Math.min(
              matrix[i - 1][j - 1] + 1,
              matrix[i][j - 1] + 1,
              matrix[i - 1][j] + 1
            );
          }
        }
      }
      return matrix[b.length][a.length];
    }

    // Comprobar coincidencia fuzzy
    function matchProductFuzzy(product, query) {
      if (!query) return true;
      const queryWords = query.toLowerCase().split(/\s+/).filter(w => w.length >= 2);
      if (queryWords.length === 0) return true;
      
      const searchFields = [
        product.name,
        product.description || '',
        product.category
      ].join(' ').toLowerCase();

      const productWords = searchFields.split(/[\s,.:;?!()""']+/).filter(w => w.length >= 2);

      return queryWords.every(qw => {
        return productWords.some(pw => {
          if (pw.includes(qw) || qw.includes(pw)) return true;
          if (qw.length < 4) return pw === qw;
          const maxEdits = qw.length <= 6 ? 1 : 2;
          return levenshtein(qw, pw) <= maxEdits;
        });
      });
    }

    // Resaltar coincidencias de forma inteligente
    function highlightText(text, query) {
      if (!query) return text;
      const queryWords = query.toLowerCase().split(/\s+/).filter(w => w.length >= 2);
      if (queryWords.length === 0) return text;

      const textWords = text.split(/(\s+)/);
      
      const highlightedWords = textWords.map(part => {
        if (/^\s+$/.test(part)) return part;
        const cleanWord = part.toLowerCase().replace(/[,.:;?!()""']/g, '');
        
        const matches = queryWords.some(qw => {
          if (cleanWord.includes(qw) || qw.includes(cleanWord)) return true;
          if (qw.length < 4) return cleanWord === qw;
          const maxEdits = qw.length <= 6 ? 1 : 2;
          return levenshtein(qw, cleanWord) <= maxEdits;
        });

        if (matches) {
          return `<mark class="search-highlight">${part}</mark>`;
        }
        return part;
      });

      return highlightedWords.join('');
    }

    // Clasificar productos en subcategorías de forma determinista y extensible
    function getProductSubcategory(product) {
      const idMap = {
        "prod-1": "Efecto Calor",
        "prod-2": "Efecto Calor",
        "prod-3": "Cuidado Natural",
        "prod-4": "Aceites de Masaje",
        "prod-5": "Aceites de Masaje",
        "prod-6": "Velas de Masaje",
        "prod-7": "Masculinos",
        "prod-8": "Masculinos",
        "prod-9": "Vibradores",
        "prod-10": "Vibradores",
        "prod-11": "Vibradores",
        "prod-12": "Vibradores",
        "prod-13": "Vibradores",
        "prod-14": "Vibradores",
        "prod-15": "Vibradores",
        "prod-16": "Vibradores",
        "prod-17": "Parejas",
        "prod-18": "Vibradores",
        "prod-19": "Plugs",
        "prod-20": "Plugs",
        "prod-21": "Plugs",
        "prod-22": "Plugs",
        "prod-23": "Anal",
        "prod-24": "Plugs",
        "prod-25": "Plugs",
        "prod-26": "Plugs",
        "prod-27": "Plugs",
        "prod-28": "Plugs",
        "prod-29": "Plugs",
        "prod-30": "Plugs"
      };
      
      if (idMap[product.id]) return idMap[product.id];
      
      const name = (product.name || '').toLowerCase();
      const desc = (product.description || '').toLowerCase();
      const cat = (product.category || '').toUpperCase();
      
      if (cat.includes('JUGUETES')) {
        if (name.includes('plug')) return 'Plugs';
        if (name.includes('beads') || name.includes('anal') || name.includes('bolas anales')) return 'Anal';
        if (name.includes('pareja') || name.includes('doble')) return 'Parejas';
        if (name.includes('masculino') || name.includes('hombre') || name.includes('pene') || name.includes('perineal') || name.includes('próstata')) return 'Masculinos';
        return 'Vibradores';
      }
      if (cat.includes('COSMÉTICA') || cat.includes('COSMETICA') || cat.includes('SENSORIAL')) {
        if (name.includes('calor') || desc.includes('calor')) return 'Efecto Calor';
        if (name.includes('vela')) return 'Velas de Masaje';
        return 'Aceites de Masaje';
      }
      if (cat.includes('BDSM')) {
        return 'Bondage';
      }
      if (cat.includes('SALUD') || cat.includes('BIENESTAR') || cat.includes('ÍNTIMA') || cat.includes('INTIMA')) {
        return 'Cuidado Natural';
      }
      return 'Otros';
    }

    const subcategoriesData = {
      "JUGUETES": ["Vibradores", "Masculinos", "Anal", "Parejas", "Plugs"],
      "COSMÉTICA SENSORIAL": ["Efecto Calor", "Aceites de Masaje", "Velas de Masaje"],
      "BDSM": ["Bondage"],
      "SALUD ÍNTIMA": ["Cuidado Natural"]
    };

    // Cargar categoría inicial desde URL si existe
    const urlParams = new URLSearchParams(window.location.search);
    const urlCategory = urlParams.get('category');
    const urlSubcategory = urlParams.get('subcategory');
    
    let currentCategory = 'all';
    if (urlCategory) {
      currentCategory = urlCategory;
    }
    let currentSubcategory = 'all';
    if (urlSubcategory) {
      currentSubcategory = urlSubcategory;
    }
    let currentQuery = '';
    let currentSort = 'default';

    // Paginación
    let currentPage = 1;
    const ITEMS_PER_PAGE = 16;
    const paginationContainer = document.getElementById('catalog-pagination-container');

    const gridSearchInput = document.getElementById('grid-search-input');
    const clearGridSearchBtn = document.getElementById('clear-grid-search-btn');
    const sortSelect = document.getElementById('grid-sort-select');
    const productsGrid = document.getElementById('main-products-grid');
    const noProductsBox = document.getElementById('no-products-found');
    const counterText = document.getElementById('grid-counter-text');
    const resetFiltersBtn = document.getElementById('reset-grid-filters-btn');
    const triggerHeroSearchBtn = document.getElementById('trigger-hero-search-btn');
    const subcategoryWrapper = document.getElementById('subcategory-filter-wrapper');
    const subcategoryChips = document.getElementById('subcategory-filter-chips');

    // Botón del Hero para abrir el buscador global
    if (triggerHeroSearchBtn) {
      triggerHeroSearchBtn.addEventListener('click', () => {
        document.getElementById('open-search-modal-btn')?.click();
      });
    }

    // Actualizar la interfaz de subcategorías desplegables con transiciones
    function updateSubcategoriesUI() {
      if (!subcategoryWrapper || !subcategoryChips) return;

      const subCats = subcategoriesData[currentCategory];

      if (!subCats || subCats.length === 0) {
        // Ocultar y contraer
        subcategoryChips.style.opacity = '0';
        subcategoryChips.style.transform = 'translateY(-8px)';
        subcategoryWrapper.style.height = '0px';
        return;
      }

      // Generar los chips HTML
      let html = `
        <button class="grid-sub-cat-btn ${currentSubcategory === 'all' ? 'active' : ''}" data-subcat="all">
          Todos los artículos
        </button>
      `;

      subCats.forEach(sub => {
        const count = initialProducts.filter(p => p.category === currentCategory && getProductSubcategory(p) === sub).length;
        html += `
          <button class="grid-sub-cat-btn ${currentSubcategory === sub ? 'active' : ''}" data-subcat="${sub}">
            ${sub} (${count})
          </button>
        `;
      });

      subcategoryChips.innerHTML = html;

      // Click listeners para subcategorías
      subcategoryChips.querySelectorAll('.grid-sub-cat-btn').forEach(subBtn => {
        subBtn.addEventListener('click', (e) => {
          subcategoryChips.querySelectorAll('.grid-sub-cat-btn').forEach(b => b.classList.remove('active'));
          const target = e.currentTarget;
          target.classList.add('active');
          currentSubcategory = target.getAttribute('data-subcat') || 'all';
          currentPage = 1;
          renderProducts();
        });
      });

      // Transición suave: calcular scrollHeight
      subcategoryWrapper.style.height = 'auto';
      const height = subcategoryChips.scrollHeight + 'px';
      subcategoryWrapper.style.height = '0px';
      
      // Forzar repaint para que se aplique la transición
      subcategoryWrapper.offsetHeight;

      subcategoryWrapper.style.height = height;
      subcategoryChips.style.opacity = '1';
      subcategoryChips.style.transform = 'translateY(0)';
    }

    // Filtrar por categoría principal
    document.querySelectorAll('.grid-cat-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.grid-cat-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget;
        target.classList.add('active');
        currentCategory = target.getAttribute('data-category') || 'all';
        currentSubcategory = 'all'; // Restablecer subcategoría
        currentPage = 1;
        
        updateSubcategoriesUI();
        renderProducts();
      });
    });

    // Búsqueda en vivo
    if (gridSearchInput && clearGridSearchBtn) {
      gridSearchInput.addEventListener('input', () => {
        currentQuery = gridSearchInput.value.trim().toLowerCase();
        clearGridSearchBtn.style.display = currentQuery ? 'inline-flex' : 'none';
        currentPage = 1;
        renderProducts();
      });

      clearGridSearchBtn.addEventListener('click', () => {
        gridSearchInput.value = '';
        currentQuery = '';
        clearGridSearchBtn.style.display = 'none';
        currentPage = 1;
        renderProducts();
        gridSearchInput.focus();
      });
    }

    // Ordenación
    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        currentSort = sortSelect.value;
        currentPage = 1;
        renderProducts();
      });
    }

    // Resetear filtros
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        currentCategory = 'all';
        currentSubcategory = 'all';
        currentQuery = '';
        currentSort = 'default';
        currentPage = 1;
        if (gridSearchInput) gridSearchInput.value = '';
        if (clearGridSearchBtn) clearGridSearchBtn.style.display = 'none';
        if (sortSelect) sortSelect.value = 'default';

        document.querySelectorAll('.grid-cat-btn').forEach(b => b.classList.remove('active'));
        document.querySelector('.grid-cat-btn[data-category="all"]')?.classList.add('active');

        updateSubcategoriesUI();
        renderProducts();
      });
    }

    function renderProducts() {
      if (!productsGrid || !counterText || !noProductsBox) return;

      // Actualizar texto de los chips de categoría según si hay búsqueda activa o no
      document.querySelectorAll('.grid-cat-btn').forEach(btn => {
        const catName = btn.getAttribute('data-category');
        if (currentQuery) {
          // Ocultar contador entre paréntesis si se busca por texto
          if (catName === 'all') {
            btn.textContent = 'Todas';
          } else {
            btn.textContent = formatCategoryName(catName);
          }
        } else {
          // Restaurar contador de productos
          if (catName === 'all') {
            btn.textContent = `Todas (${initialProducts.length})`;
          } else {
            const count = initialProducts.filter(p => p.category === catName).length;
            btn.textContent = `${formatCategoryName(catName)} (${count})`;
          }
        }
      });

      // 1. Filtrar con soporte fuzzy y subcategorías
      let filtered = initialProducts.filter(p => {
        const matchCat = currentCategory === 'all' || p.category === currentCategory;
        if (!matchCat) return false;
        
        const matchSubcat = currentSubcategory === 'all' || getProductSubcategory(p) === currentSubcategory;
        if (!matchSubcat) return false;
        
        return matchProductFuzzy(p, currentQuery);
      });

      // 2. Ordenar con soporte robusto para valores numéricos
      if (currentSort === 'price-asc') {
        filtered.sort((a, b) => {
          const priceA = parseFloat(a.price) || 0;
          const priceB = parseFloat(b.price) || 0;
          return priceA - priceB;
        });
      } else if (currentSort === 'price-desc') {
        filtered.sort((a, b) => {
          const priceA = parseFloat(a.price) || 0;
          const priceB = parseFloat(b.price) || 0;
          return priceB - priceA;
        });
      } else if (currentSort === 'name-asc') {
        filtered.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
      }

      // 3. Paginación
      const totalItems = filtered.length;
      const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

      if (totalItems === 0) {
        productsGrid.style.display = 'none';
        noProductsBox.style.display = 'block';
        counterText.innerHTML = `Mostrando <strong style="color: var(--primary);">0</strong> de <strong>${initialProducts.length}</strong> productos`;
        if (paginationContainer) paginationContainer.innerHTML = '';
        return;
      }

      // Ajustar página activa si está fuera de límites
      if (currentPage > totalPages) {
        currentPage = Math.max(1, totalPages);
      }

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalItems);
      const paginatedProducts = filtered.slice(startIndex, endIndex);

      productsGrid.style.display = 'grid';
      noProductsBox.style.display = 'none';
      counterText.innerHTML = `Mostrando <strong style="color: var(--accent);">${startIndex + 1}-${endIndex}</strong> de <strong style="color: var(--accent);">${totalItems}</strong> productos`;

      productsGrid.innerHTML = paginatedProducts.map(product => {
        const highlightedTitle = highlightText(product.name, currentQuery);
        const highlightedDesc = highlightText(product.description || '', currentQuery);

        return `
          <article class="product-card">
            ${product.oldPrice ? `
              <span style="position: absolute; top: 16px; left: 16px; background-color: var(--primary); color: white; padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; z-index: 10;">
                Oferta
              </span>
            ` : ''}

            <a href="/producto/${product.slug}" class="product-image-container" aria-label="Ver detalles de ${product.name}">
              <img 
                src="${product.image}" 
                alt="${product.name}"
                class="product-image-zoom"
                loading="lazy"
              />
            </a>

            <div class="product-card-body" style="padding: 22px; display: flex; flex-direction: column; flex-grow: 1;">
              <span style="color: var(--accent); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">${product.category}</span>
              <a href="/producto/${product.slug}" style="color: inherit; text-decoration: none;">
                <h3 style="font-size: 1.15rem; margin-bottom: 10px; line-height: 1.3; font-weight: 700; transition: color 0.2s;" class="product-title-link">${highlightedTitle}</h3>
              </a>
              <p style="color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 20px; flex-grow: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                ${highlightedDesc}
              </p>
              
              <div class="product-card-footer" style="display: flex; align-items: center; justify-content: center; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border-color);">
                <div style="display: flex; align-items: baseline; gap: 8px; justify-content: center; width: 100%;">
                  <span style="font-size: 1.35rem; font-weight: 800; color: var(--text-primary);">${product.price}€</span>
                  ${product.oldPrice ? `
                    <span style="font-size: 0.9rem; text-decoration: line-through; color: var(--text-secondary);">${product.oldPrice}€</span>
                  ` : ''}
                </div>
              </div>
            </div>

          </article>
        `;
      }).join('');

      // Renderizar controles de paginación
      renderPaginationControls(totalPages);
    }

    function renderPaginationControls(totalPages) {
      if (!paginationContainer) return;

      if (totalPages <= 1) {
        paginationContainer.innerHTML = '';
        return;
      }

      let html = '';

      // Botón Anterior
      html += `
        <button 
          class="pagination-btn pagination-arrow" 
          ${currentPage === 1 ? 'disabled' : ''} 
          data-page="${currentPage - 1}"
          aria-label="Página anterior"
        >
          &larr;
        </button>
      `;

      // Números de Página (paginación inteligente con elipsis)
      const pagesToShow = [];
      const range = 1; // número de páginas vecinas a la actual

      for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || (i >= currentPage - range && i <= currentPage + range)) {
          pagesToShow.push(i);
        } else if (pagesToShow[pagesToShow.length - 1] !== '...') {
          pagesToShow.push('...');
        }
      }

      pagesToShow.forEach(page => {
        if (page === '...') {
          html += `<span class="pagination-ellipsis">&hellip;</span>`;
        } else {
          html += `
            <button 
              class="pagination-btn ${page === currentPage ? 'active' : ''}" 
              data-page="${page}"
              aria-label="Ir a la página ${page}"
            >
              ${page}
            </button>
          `;
        }
      });

      // Botón Siguiente
      html += `
        <button 
          class="pagination-btn pagination-arrow" 
          ${currentPage === totalPages ? 'disabled' : ''} 
          data-page="${currentPage + 1}"
          aria-label="Página siguiente"
        >
          &rarr;
        </button>
      `;

      paginationContainer.innerHTML = html;

      // Escuchar eventos en los botones de paginación
      paginationContainer.querySelectorAll('.pagination-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget;
          const page = parseInt(target.getAttribute('data-page') || '1');
          
          if (page !== currentPage && page >= 1 && page <= totalPages) {
            currentPage = page;
            renderProducts();
            
            // Scroll suave al inicio del catálogo
            document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
    }

    // Inicializar la primera renderización al cargar la página
    if (urlCategory) {
      document.querySelectorAll('.grid-cat-btn').forEach(btn => {
        if (btn.getAttribute('data-category')?.toUpperCase() === urlCategory.toUpperCase()) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
      // Scroll automático al catálogo si viene con categoría desde URL
      setTimeout(() => {
        document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
      }, 100);
    }
    updateSubcategoriesUI();
    renderProducts();

    // Escuchar eventos personalizados del menú hamburguesa / navegación global
    window.addEventListener('filter-category-subcategory', (e) => {
      const { category, subcategory } = e.detail;
      currentCategory = category || 'all';
      currentSubcategory = subcategory || 'all';
      currentPage = 1;

      // Actualizar clases activas en los botones de categoría principal
      document.querySelectorAll('.grid-cat-btn').forEach(btn => {
        const catVal = btn.getAttribute('data-category');
        if (catVal === currentCategory) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      updateSubcategoriesUI();
      renderProducts();

      // Scroll suave al catálogo
      document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Evento del botón de añadir al carrito del Hero
    document.querySelector('.hero-add-cart-btn')?.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const id = target.getAttribute('data-id');
      const name = target.getAttribute('data-name');
      const price = parseFloat(target.getAttribute('data-price') || '0');
      const image = target.getAttribute('data-image');

      if (!id || !name) return;

      let cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const existingItem = cart.find(item => item.id === id);

      if (existingItem) {
        existingItem.quantity += 1;
      } else {
        cart.push({ id, name, price, image, quantity: 1 });
      }

      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));

      const orig = target.textContent || 'Añadir';
      target.textContent = '¡Añadido! ✓';
      target.style.backgroundColor = 'var(--success)';
      target.style.borderColor = 'var(--success)';
      
      setTimeout(() => {
        target.textContent = orig;
        target.style.backgroundColor = '';
        target.style.borderColor = '';
      }, 1500);
    });

    // Copiar cupón en Hero
    document.getElementById('copy-hero-promo-btn')?.addEventListener('click', (e) => {
      const targetBtn = e.currentTarget;
      const code = targetBtn.getAttribute('data-code') || 'REBAJAS15';
      
      navigator.clipboard.writeText(code).then(() => {
        const orig = targetBtn.textContent || 'Copiar';
        targetBtn.textContent = '¡Copiado! ✓';
        targetBtn.style.backgroundColor = 'var(--success)';
        targetBtn.style.borderColor = 'var(--success)';
        setTimeout(() => {
          targetBtn.textContent = orig;
          targetBtn.style.backgroundColor = '';
          targetBtn.style.borderColor = '';
        }, 2000);
      });
    });
  </script>
</Layout>
