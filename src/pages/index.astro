---
import Layout from '../layouts/Layout.astro';
import { getAllProducts } from '../lib/products';
import { sanityClient, isSanityConfigured } from '../db/sanity';

const allProducts = await getAllProducts();

// Configuración local del Banner Principal
const localHeroSettings = {
  isPromoActive: true,
  tag: 'Descuento de lanzamiento',
  title: 'Juguetes eróticos y cosmética para disfrutar',
  subtitle: 'Encuentra las mejores marcas internacionales de bienestar íntimo. Envíos 100% discretos en 24h o recogida local en nuestro almacén en Churra, Murcia.',
  promoCode: 'APPLE20',
  promoDetails: '20% de descuento en toda la web',
  promoExclusions: '*Excepto afrodisíacos',
  image: allProducts[0]?.image || '/images/vibrador_minimalista.jpg',
  buttonText: 'Ver recomendaciones',
  productName: allProducts[0]?.name || 'ACEITE DE MASAJE EFECTO CALOR',
  productDescription: allProducts[0]?.description || 'Formulado con ingredientes naturales para estimular los sentidos de forma sensual.',
  productPrice: `${allProducts[0]?.price || 29.95}€`
};

let heroSettings = localHeroSettings;

if (isSanityConfigured()) {
  try {
    const heroQuery = `*[_type == "homepageSettings"][0] {
      isPromoActive,
      tag,
      title,
      subtitle,
      promoCode,
      promoDetails,
      promoExclusions,
      "image": image.asset->url,
      buttonText,
      productName,
      productDescription,
      productPrice
    }`;
    const sanityHeroSettings = await sanityClient.fetch(heroQuery);
    if (sanityHeroSettings) {
      heroSettings = { ...localHeroSettings, ...sanityHeroSettings };
    }
  } catch (error) {
    console.warn('Error al cargar la configuración de Sanity:', error);
  }
}

// Extraer categorías únicas para los filtros
const categoriesOrder = ["JUGUETES", "COSMÉTICA SENSORIAL", "BDSM", "SALUD ÍNTIMA"];
const categories = Array.from(new Set(allProducts.map(p => p.category)))
  .filter(Boolean)
  .sort((a, b) => categoriesOrder.indexOf(a) - categoriesOrder.indexOf(b));

// Helper para formatear categorías a Camel Case (Title Case) respetando nexos
function formatCategoryName(str) {
  if (!str) return '';
  const words = str.toLowerCase().split(' ');
  const formattedWords = words.map((word, index) => {
    const lowerWords = ['y', 'e', 'o', 'u', 'de', 'del', 'con', 'para', 'en'];
    if (lowerWords.includes(word) && index > 0) {
      return word;
    }
    return word.charAt(0).toUpperCase() + word.slice(1);
  });
  return formattedWords.join(' ');
}
---

<Layout 
  title="Inicio - Catálogo Oficial" 
  description="Explora los 30 productos de nuestra boutique erótica y bienestar íntimo en Churra, Murcia. Envíos discretos 24h o recogida local en 2 horas."
>
  <!-- Hero Section con gradiente animado y diseño premium -->
  <section style="position: relative; padding: 100px 0 70px 0; overflow: hidden; background: radial-gradient(circle at 80% 20%, rgba(216, 75, 140, 0.1) 0%, transparent 50%), radial-gradient(circle at 10% 80%, rgba(216, 75, 140, 0.05) 0%, transparent 40%);">
    <div class="container hero-grid" style="z-index: 2; position: relative;">
      
      <!-- Textos Hero -->
      <div>
        <span style="color: var(--primary); text-transform: uppercase; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.15em; display: inline-block; margin-bottom: 16px;">
          {heroSettings.tag}
        </span>
        
        {heroSettings.isPromoActive ? (
          <div>
            <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.5rem); line-height: 1.1; margin-bottom: 8px;">
              {heroSettings.title}
            </h1>
            <h2 style="font-size: clamp(1.6rem, 3.5vw, 2.6rem); font-family: var(--font-title); font-weight: 800; color: var(--primary); margin-bottom: 20px; line-height: 1.2;">
              {heroSettings.promoDetails}
            </h2>
            <p style="color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 24px; max-width: 500px;">
              {heroSettings.subtitle}
            </p>
            
            <!-- Caja de Cupón Interactiva y Profesional -->
            <div class="promo-box-container" style="background: #ffffff; border: 1px dashed var(--primary); border-radius: 12px; padding: 16px 20px; max-width: 420px; display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 8px; width: 100%; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
              <div>
                <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-secondary); display: block; margin-bottom: 2px;">CÓDIGO DE DESCUENTO</span>
                <strong style="font-family: var(--font-title); font-size: 1.4rem; color: var(--primary); letter-spacing: 0.05em;">{heroSettings.promoCode}</strong>
              </div>
              <button 
                id="copy-hero-promo-btn" 
                class="btn btn-primary" 
                data-code={heroSettings.promoCode}
                style="padding: 8px 16px; font-size: 0.85rem; border-radius: 8px;"
              >
                Copiar
              </button>
            </div>
            
            {heroSettings.promoExclusions && (
              <span class="promo-exclusions-text" style="display: block; font-size: 0.8rem; color: var(--text-secondary); font-style: italic; margin-bottom: 30px;">
                {heroSettings.promoExclusions}
              </span>
            )}
            
            <div style="display: flex; gap: 16px; flex-wrap: wrap;">
              <a href="#catalogo" class="btn btn-primary" style="padding: 14px 28px; font-size: 1rem; border-radius: 12px;">Explorar Catálogo</a>
            </div>
          </div>
        ) : (
          <div>
            <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 24px;">
              {heroSettings.title}
            </h1>
            <p style="color: var(--text-secondary); font-size: 1.15rem; margin-bottom: 32px; max-width: 500px;">
              {heroSettings.subtitle}
            </p>
            <div style="display: flex; gap: 16px; flex-wrap: wrap;">
              <a href="#catalogo" class="btn btn-primary" style="padding: 14px 28px; font-size: 1rem; border-radius: 12px;" id="hero-explore-btn">Explorar Catálogo</a>
            </div>
          </div>
        )}
      </div>

      <!-- Imagen Destacada del Producto Estrella -->
      <div style="position: relative; display: flex; justify-content: center;">
        <div style="position: absolute; width: 300px; height: 300px; background: var(--primary); filter: blur(100px); opacity: 0.12; top: 10%; left: 10%; border-radius: 50%; z-index: -1;"></div>
        <div style="border-radius: 24px; overflow: hidden; border: 1px solid var(--border-color); box-shadow: var(--shadow-premium); background: #ffffff; padding: 24px; max-width: 420px; text-align: center; width: 100%;">
          <img src={heroSettings.image} alt={heroSettings.productName} style="width: 100%; border-radius: 16px; object-fit: cover; aspect-ratio: 1; margin-bottom: 20px; border: 1px solid var(--border-color); background: #f7f7fa;" />
          <span style="background: rgba(216, 75, 140, 0.08); color: var(--primary); font-size: 0.75rem; font-weight: 700; padding: 4px 12px; border-radius: 20px; text-transform: uppercase; display: inline-block; margin-bottom: 8px;">DESTACADO DE HOY</span>
          <h3 style="font-size: 1.2rem; margin-bottom: 8px; font-weight: 700;">{heroSettings.productName}</h3>
          <p style="color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 16px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{heroSettings.productDescription}</p>
          <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 12px; border-top: 1px solid var(--border-color);">
            <span style="color: var(--primary); font-weight: 800; font-size: 1.3rem;">{heroSettings.productPrice}</span>
            <button class="btn btn-primary hero-add-cart-btn" data-id={allProducts[0]?.id} data-name={allProducts[0]?.name} data-price={allProducts[0]?.price} data-image={allProducts[0]?.image} style="padding: 8px 16px; font-size: 0.85rem;">
              Añadir a la cesta
            </button>
          </div>
        </div>
      </div>

    </div>
  </section>


  <!-- Burbujas de Categorías estilo Instagram Stories -->
  <section style="padding: 24px 0 10px 0; background: #ffffff;">
    <div class="categories-bubbles-container">
      
      <button class="category-bubble-item" data-category="JUGUETES" style="background: transparent; border: none; padding: 0; font-family: inherit;">
        <div class="category-bubble-img" style="color: #e45b9a; background: #fdfafb;">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </div>
        <span class="category-bubble-label">Juguetes</span>
      </button>

      <button class="category-bubble-item" data-category="COSMÉTICA SENSORIAL" style="background: transparent; border: none; padding: 0; font-family: inherit;">
        <div class="category-bubble-img" style="color: #885df1; background: #fbf9ff;">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
          </svg>
        </div>
        <span class="category-bubble-label">Cosmética</span>
      </button>

      <button class="category-bubble-item" data-category="BDSM" style="background: transparent; border: none; padding: 0; font-family: inherit;">
        <div class="category-bubble-img" style="color: #3b3759; background: #f7f6f9;">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <span class="category-bubble-label">BDSM</span>
      </button>

      <button class="category-bubble-item" data-category="SALUD ÍNTIMA" style="background: transparent; border: none; padding: 0; font-family: inherit;">
        <div class="category-bubble-img" style="color: #10b981; background: #f2faf7;">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <span class="category-bubble-label">Salud Íntima</span>
      </button>

    </div>
  </section>

  <!-- Sección Catálogo de Productos con Buscador Inteligente Integrado -->
  <!-- Sección Catálogo de Productos (Recomendados) -->
  <section id="catalogo" style="padding: 90px 0; background: #ffffff;">
    <div class="container">
      
      <div style="text-align: center; margin-bottom: 48px;">
        <span style="color: var(--primary); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 8px;">NUESTRA SELECCIÓN</span>
        <h2 style="font-size: clamp(2rem, 3.5vw, 2.8rem); margin-bottom: 12px; font-family: var(--font-title); font-weight: 800;">Recomendaciones</h2>
        <p style="color: var(--text-secondary); max-width: 600px; margin: 0 auto; font-size: 1.05rem; line-height: 1.5;">
          Una cuidada selección de nuestros mejores artículos eróticos y bienestar íntimo para disfrutar a solas o en pareja.
        </p>
      </div>

      <!-- Parrilla de Productos Recomendados (Estática y veloz) -->
      <div class="products-grid">
        {allProducts.slice(0, 8).map(product => (
          <article class="product-card">
            {product.oldPrice ? (
              <span style="position: absolute; top: 16px; left: 16px; background-color: var(--primary); color: white; padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; z-index: 10;">
                Oferta
              </span>
            ) : null}

            <a href={`/producto/${product.slug}`} class="product-image-container" aria-label={`Ver detalles de ${product.name}`}>
              <img 
                src={product.image} 
                alt={product.name}
                class="product-image-zoom"
                loading="lazy"
              />
            </a>

            <div class="product-card-body" style="padding: 22px; display: flex; flex-direction: column; flex-grow: 1;">
              <span style="color: var(--accent); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">{product.category}</span>
              <a href={`/producto/${product.slug}`} style="color: inherit; text-decoration: none;">
                <h3 style="font-size: 1.15rem; margin-bottom: 10px; line-height: 1.3; font-weight: 700; transition: color 0.2s;" class="product-title-link">{product.name}</h3>
              </a>
              <p style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.4; margin-bottom: 20px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 2.8em;">
                {product.description || ''}
              </p>
              
              <div style="display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border-color);">
                <div style="display: flex; align-items: baseline; gap: 6px;">
                  {product.oldPrice ? (
                    <span style="font-size: 0.9rem; text-decoration: line-through; color: var(--text-secondary);">{product.oldPrice}€</span>
                  ) : null}
                  <span style="font-size: 1.2rem; font-weight: 800; color: var(--text-primary);">{product.price}€</span>
                </div>
                <button 
                  class="btn btn-primary add-to-cart-btn" 
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.price}
                  data-image={product.image}
                  style="padding: 8px 14px; font-size: 0.85rem; border-radius: 8px;"
                >
                  Comprar
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Gran CTA central para abrir el Catálogo Completo en el Buscador Modal -->
      <div style="text-align: center; margin-top: 48px;">
        <button 
          id="open-catalog-full-btn"
          class="btn btn-primary" 
          style="padding: 16px 36px; font-size: 1rem; font-weight: 700; border-radius: 12px; text-transform: uppercase; letter-spacing: 0.05em; background: linear-gradient(135deg, #e45b9a, #c43b7a); border: none; box-shadow: var(--shadow-glow);"
        >
          Ver Catálogo Completo ({allProducts.length} artículos)
        </button>
      </div>

    </div>
  </section>

  <!-- Ventajas Locales -->
  <section id="envios" style="padding: 50px 0; border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); background-color: #ffffff;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px;">
        
        <div class="glass" style="padding: 28px; border-radius: var(--border-radius); transition: var(--transition-smooth); text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.02); display: flex; flex-direction: column;">
          <div style="background: rgba(216, 75, 140, 0.08); width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; color: var(--primary);">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; font-weight: 700; color: var(--text-primary);">Recogida Express en 2h</h3>
          <p style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.4; margin: 0;">
            Compra online en 1 clic y recoge tu pedido listo en nuestra tienda de <strong>Churra, Murcia</strong> sin coste de envío.
          </p>
        </div>

        <div class="glass" style="padding: 28px; border-radius: var(--border-radius); transition: var(--transition-smooth); text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.02); display: flex; flex-direction: column;">
          <div style="background: rgba(216, 75, 140, 0.08); width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; color: var(--primary);">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; font-weight: 700; color: var(--text-primary);">Envíos 100% Discretos</h3>
          <p style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.4; margin: 0;">
            Caja marrón neutra sin logotipos ni marcas externas. Tu privacidad e intimidad están totalmente garantizadas.
          </p>
        </div>

        <div class="glass" style="padding: 28px; border-radius: var(--border-radius); transition: var(--transition-smooth); text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.02); display: flex; flex-direction: column;">
          <div style="background: rgba(216, 75, 140, 0.08); width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; color: var(--primary);">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; font-weight: 700; color: var(--text-primary);">Atención Confidencial</h3>
          <p style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.4; margin: 0;">
            ¿Necesitas asesoría sobre algún producto? Te atendemos por WhatsApp con la máxima discreción y amabilidad.
          </p>
        </div>

        <div class="glass" style="padding: 28px; border-radius: var(--border-radius); transition: var(--transition-smooth); text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.02); display: flex; flex-direction: column;">
          <div style="background: rgba(216, 75, 140, 0.08); width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; color: var(--primary);">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; font-weight: 700; color: var(--text-primary);">Compra 100% Segura</h3>
          <p style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.4; margin: 0;">
            Tus pagos están totalmente protegidos con encriptación SSL de grado militar a través de <strong>Stripe</strong>. Tarjeta, Bizum o Apple Pay.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Sección Recogida e Inmediatez Local (Tienda Física Murcia) -->
  <section id="recogida" style="padding: 90px 0; background: #ffffff; border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
    <div class="container">
      
      <!-- Contenedor Banner de alta calidad - Mimetizado con el fondo claro -->
      <div class="store-banner-wrapper" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: 24px; padding: 48px; color: var(--text-primary); position: relative; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.03); display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px; align-items: center;">
        
        <!-- Efecto de brillo de fondo suave en tonos rosados muy sutiles -->
        <div style="position: absolute; width: 300px; height: 300px; background: var(--primary); filter: blur(130px); opacity: 0.04; top: -50px; left: -50px; border-radius: 50%; pointer-events: none; z-index: 1;"></div>

        <!-- Info principal de la tienda -->
        <div style="position: relative; z-index: 2;">
          <span style="color: var(--primary); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; display: inline-block; margin-bottom: 12px; background: rgba(216, 75, 140, 0.06); padding: 4px 12px; border-radius: 20px;">NUESTRA TIENDA FÍSICA</span>
          <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); line-height: 1.2; margin-bottom: 24px; font-family: var(--font-title); font-weight: 800; color: var(--text-primary); margin-top: 0;">
            Visítanos en <span style="color: var(--primary);">Churra, Murcia</span>
          </h2>
          
          <!-- Grid esquematizado de ventajas de visitarnos -->
          <div class="store-features-grid" style="display: flex; flex-direction: column; gap: 20px;">
            
            <div style="display: flex; gap: 16px; align-items: flex-start; background: #fdfafb; border: 1px solid #f9f2f5; padding: 18px; border-radius: 16px;">
              <div style="background: rgba(216, 75, 140, 0.08); width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--primary); flex-shrink: 0;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div>
                <h4 style="font-size: 1.05rem; margin-bottom: 4px; font-weight: 700; color: var(--text-primary); margin-top: 0;">Asesoramiento Íntimo y Especializado</h4>
                <p style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.4; margin: 0;">
                  Te ofrecemos un trato cercano, discreto y profesional. Te ayudamos, asesoramos y aconsejamos para encontrar el producto ideal para ti con total confianza.
                </p>
              </div>
