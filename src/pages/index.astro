          style="background: transparent; border: 1px solid rgba(255, 255, 255, 0.2); color: #ffffff; font-size: 0.95rem; border-radius: 12px; padding: 12px 30px; transition: var(--transition-smooth); width: 100%; max-width: 320px; box-shadow: none;"
        >
          Explorar catálogo completo
