  <!-- Hero Section con gradiente animado y diseño premium -->
  <section class="hero-section">
    <div class="container hero-grid" style="z-index: 2; position: relative;">
      
      <!-- Textos Hero -->
      <div>
        <span style="color: var(--primary); text-transform: uppercase; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.15em; display: inline-block; margin-bottom: 12px;">
