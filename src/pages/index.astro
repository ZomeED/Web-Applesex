      let subCats = [];
      for (const [key, val] of Object.entries(subcategoriesData)) {
        if (normalizeCategory(key) === normalizedCurrentCat) {
          subCats = val;
          break;
        }
      }

      if (!subCats || subCats.length === 0) {
        // Ocultar y contraer
        subcategoryChips.style.opacity = '0';
        subcategoryChips.style.transform = 'translateY(-8px)';
        subcategoryWrapper.style.height = '0px';
        return;
      }

      // Generar los chips HTML
      let html = `
        <button class="grid-sub-cat-btn ${currentSubcategory === 'all' ? 'active' : ''}" data-subcat="all">
          Todos los artículos
        </button>
      `;

      subCats.forEach(sub => {
        html += `
          <button class="grid-sub-cat-btn ${currentSubcategory === sub ? 'active' : ''}" data-subcat="${sub}">
            ${sub}
          </button>
        `;
      });

      subcategoryChips.innerHTML = html;

      // Click listeners para subcategorías
      subcategoryChips.querySelectorAll('.grid-sub-cat-btn').forEach(subBtn => {
        subBtn.addEventListener('click', (e) => {
          subcategoryChips.querySelectorAll('.grid-sub-cat-btn').forEach(b => b.classList.remove('active'));
          const target = e.currentTarget;
          target.classList.add('active');
          currentSubcategory = target.getAttribute('data-subcat') || 'all';
          currentPage = 1;
          renderProducts();

          // Scroll suave al inicio del catálogo al cambiar de subcategoría
          document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
        });
      });

      // Transición suave: calcular scrollHeight
      subcategoryWrapper.style.height = 'auto';
      const height = subcategoryChips.scrollHeight + 'px';
      subcategoryWrapper.style.height = '0px';
      
      // Forzar repaint para que se aplique la transición
      subcategoryWrapper.offsetHeight;

      subcategoryWrapper.style.height = height;
      subcategoryChips.style.opacity = '1';
      subcategoryChips.style.transform = 'translateY(0)';
    }

    // Filtrar por categoría principal
    document.querySelectorAll('.cat-filter-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.cat-filter-btn').forEach(b => b.classList.remove('active'));
        const target = e.currentTarget;
        target.classList.add('active');
        currentCategory = target.getAttribute('data-category') || 'all';
        currentSubcategory = 'all'; // Restablecer subcategoría
        currentPage = 1;
        
        updateSubcategoriesUI();
        renderProducts();

        // Scroll suave al inicio del catálogo al cambiar de categoría principal
        document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // Búsqueda en vivo
    if (gridSearchInput && clearGridSearchBtn) {
      gridSearchInput.addEventListener('input', () => {
        currentQuery = gridSearchInput.value.trim().toLowerCase();
        clearGridSearchBtn.style.display = currentQuery ? 'inline-flex' : 'none';
        currentPage = 1;
        renderProducts();
      });

      clearGridSearchBtn.addEventListener('click', () => {
        gridSearchInput.value = '';
        currentQuery = '';
        clearGridSearchBtn.style.display = 'none';
        currentPage = 1;
        renderProducts();
        gridSearchInput.focus();
      });
    }

    // Ordenación
    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        currentSort = sortSelect.value;
        currentPage = 1;
        renderProducts();
      });
    }

    // Resetear filtros
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        currentCategory = 'all';
        currentSubcategory = 'all';
        currentQuery = '';
        currentSort = 'default';
        currentPage = 1;
        if (gridSearchInput) gridSearchInput.value = '';
        if (clearGridSearchBtn) clearGridSearchBtn.style.display = 'none';
        if (sortSelect) sortSelect.value = 'default';

        document.querySelectorAll('.cat-filter-btn').forEach(b => b.classList.remove('active'));
        document.querySelector('.cat-filter-btn[data-category="all"]')?.classList.add('active');

        updateSubcategoriesUI();
        renderProducts();
      });
    }

    function renderProducts() {
      if (!productsGrid || !counterText || !noProductsBox) return;

      // Sincronizar parámetros de la URL sin recargar la página (como si se hubiese buscado en el navegador)
      const url = new URL(window.location.href);
      if (currentCategory && currentCategory !== 'all') {
        url.searchParams.set('category', currentCategory);
      } else {
        url.searchParams.delete('category');
      }
      if (currentSubcategory && currentSubcategory !== 'all') {
        url.searchParams.set('subcategory', currentSubcategory);
      } else {
        url.searchParams.delete('subcategory');
      }
      window.history.replaceState({
        category: currentCategory,
        subcategory: currentSubcategory,
        query: currentQuery,
        sort: currentSort,
        page: currentPage,
        scrollY: window.scrollY
      }, '', url.toString());

      saveCatalogState();

      // Actualizar dinámicamente el título y descripción del catálogo
      const catalogTitle = document.getElementById('catalog-title');
      const catalogDesc = document.getElementById('catalog-desc');
      if (catalogTitle && catalogDesc) {
        if (currentCategory === 'all') {
          catalogTitle.textContent = 'Recomendaciones';
          catalogDesc.textContent = 'Una cuidada selección de nuestros mejores artículos eróticos y bienestar íntimo para disfrutar a solas o en pareja.';
        } else {
          const formattedCat = formatCategoryName(currentCategory);
          if (currentSubcategory && currentSubcategory !== 'all') {
            catalogTitle.textContent = `${formattedCat}: ${currentSubcategory}`;
          } else {
            catalogTitle.textContent = `Todos los artículos de ${formattedCat}`;
          }
          
          if (currentCategory === 'JUGUETES') {
            catalogDesc.textContent = 'Explora nuestra amplia colección de juguetes eróticos diseñados para el placer a solas o en pareja.';
          } else if (currentCategory === 'COSMÉTICA SENSORIAL') {
            catalogDesc.textContent = 'Aceites, velas y geles con fragancias y texturas únicas para despertar tus sentidos.';
          } else if (currentCategory === 'BDSM') {
            catalogDesc.textContent = 'Atrévete a explorar nuevas sensaciones con nuestra gama de bondage y accesorios.';
          } else if (currentCategory === 'SALUD ÍNTIMA') {
            catalogDesc.textContent = 'Productos para el cuidado personal y bienestar íntimo, formulados para tu salud y protección.';
          } else {
            catalogDesc.textContent = `Todos los artículos de la categoría ${formattedCat}.`;
          }
        }
      }

      // Actualizar texto de los chips de categoría
      document.querySelectorAll('.cat-filter-btn').forEach(btn => {
        const catName = btn.getAttribute('data-category');
        if (catName === 'all') {
          btn.textContent = 'Ver todo';
        } else {
          btn.textContent = formatCategoryName(catName);
        }
      });

      // 1. Filtrar con soporte fuzzy y subcategorías
      let filtered = initialProducts.filter(p => {
        const matchCat = currentCategory === 'all' || normalizeCategory(p.category) === normalizeCategory(currentCategory);
        if (!matchCat) return false;
        
        const matchSubcat = currentSubcategory === 'all' || getProductSubcategory(p) === currentSubcategory;
        if (!matchSubcat) return false;
        
        return matchProductFuzzy(p, currentQuery);
      });

      // 2. Ordenar con soporte robusto para valores numéricos
      if (currentSort === 'default') {
        filtered.sort((a, b) => {
          const featA = a.isFeatured ? 1 : 0;
          const featB = b.isFeatured ? 1 : 0;
          if (featA !== featB) {
            return featB - featA;
          }
          return (a.name || '').localeCompare(b.name || '');
        });
      } else if (currentSort === 'price-asc') {
        filtered.sort((a, b) => {
          const priceA = parseFloat(a.price) || 0;
          const priceB = parseFloat(b.price) || 0;
          return priceA - priceB;
        });
      } else if (currentSort === 'price-desc') {
        filtered.sort((a, b) => {
          const priceA = parseFloat(a.price) || 0;
          const priceB = parseFloat(b.price) || 0;
          return priceB - priceA;
        });
      } else if (currentSort === 'name-asc') {
        filtered.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
      }

      // 3. Paginación
      const totalItems = filtered.length;
      const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

      if (totalItems === 0) {
        productsGrid.style.display = 'none';
        noProductsBox.style.display = 'block';
        counterText.innerHTML = `Mostrando <strong style="color: var(--primary);">0</strong> de <strong>${initialProducts.length}</strong> productos`;
        if (paginationContainer) paginationContainer.innerHTML = '';
        return;
      }

      // Ajustar página activa si está fuera de límites
      if (currentPage > totalPages) {
        currentPage = Math.max(1, totalPages);
      }

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalItems);
      const paginatedProducts = filtered.slice(startIndex, endIndex);

      productsGrid.style.display = 'grid';
      noProductsBox.style.display = 'none';
      counterText.innerHTML = `Mostrando <strong style="color: var(--accent);">${startIndex + 1}-${endIndex}</strong> de <strong style="color: var(--accent);">${totalItems}</strong> productos`;

      productsGrid.innerHTML = paginatedProducts.map(product => {
        const highlightedTitle = highlightText(product.name, currentQuery);
        const subtitle = getProductSubtitle(product);
        const highlightedDesc = highlightText(subtitle, currentQuery);

        return `
          <article class="product-card">
            ${product.oldPrice ? `
              <span style="position: absolute; top: 16px; left: 16px; background-color: var(--primary); color: white; padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; z-index: 10;">
                Oferta
              </span>
            ` : ''}

            <a href="/producto/${product.slug}" class="product-image-container" aria-label="Ver detalles de ${product.name}">
              <img 
                src="${product.image}" 
                alt="${product.name}"
                class="product-image-zoom"
                loading="lazy"
              />
            </a>

            <div class="product-card-body" style="padding: 22px; display: flex; flex-direction: column; flex-grow: 1;">
              <span style="color: var(--accent); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">${product.category}</span>
              <a href="/producto/${product.slug}" style="color: inherit; text-decoration: none;">
                <h3 style="font-size: 1.15rem; margin-bottom: 10px; line-height: 1.3; font-weight: 700; transition: color 0.2s;" class="product-title-link">${highlightedTitle}</h3>
              </a>
              <p style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.4; margin-bottom: 20px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 2.8em;">
                ${highlightedDesc}
              </p>
              
              <div class="product-card-footer" style="display: flex; align-items: center; justify-content: center; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border-color);">
                <div style="display: flex; align-items: baseline; gap: 8px; justify-content: center; width: 100%;">
                  ${product.oldPrice ? `
                    <span style="font-size: 0.95rem; text-decoration: line-through; color: var(--text-secondary); font-weight: 500;">${product.oldPrice}€</span>
                  ` : ''}
                  <span style="font-size: 1.35rem; font-weight: 800; color: var(--primary); font-family: var(--font-title);">${product.price}€</span>
                </div>
              </div>
            </div>

          </article>
        `;
      }).join('');

      // Renderizar controles de paginación
      renderPaginationControls(totalPages);
    }

    function renderPaginationControls(totalPages) {
      if (!paginationContainer) return;

      if (totalPages <= 1) {
        paginationContainer.innerHTML = '';
        return;
      }

      let html = '';

      // Botón Anterior
      html += `
        <button 
          class="pagination-btn pagination-arrow" 
          ${currentPage === 1 ? 'disabled' : ''} 
          data-page="${currentPage - 1}"
          aria-label="Página anterior"
        >
          &larr;
        </button>
      `;

      // Contenedor scrollable de números (ruleta interactiva)
      html += `<div class="pagination-numbers-scroll" id="pagination-scroll-container">`;
      for (let i = 1; i <= totalPages; i++) {
        html += `
          <button 
            class="pagination-btn ${i === currentPage ? 'active' : ''}" 
            data-page="${i}"
            aria-label="Ir a la página ${i}"
          >
            ${i}
          </button>
        `;
      }
      html += `</div>`;

      // Botón Siguiente
      html += `
        <button 
          class="pagination-btn pagination-arrow" 
          ${currentPage === totalPages ? 'disabled' : ''} 
          data-page="${currentPage + 1}"
          aria-label="Página siguiente"
        >
          &rarr;
        </button>
      `;

      paginationContainer.innerHTML = html;

      // Autocentrar el botón activo dentro de la ruleta scrollable sin provocar scroll vertical en la página
      const activeBtn = paginationContainer.querySelector('.pagination-btn.active');
      const scrollContainer = paginationContainer.querySelector('#pagination-scroll-container');
      if (activeBtn && scrollContainer) {
        setTimeout(() => {
          const parentLeft = scrollContainer.getBoundingClientRect().left;
          const btnLeft = activeBtn.getBoundingClientRect().left;
          const relativeLeft = btnLeft - parentLeft + scrollContainer.scrollLeft;
          const targetScrollLeft = relativeLeft - (scrollContainer.clientWidth / 2) + (activeBtn.clientWidth / 2);
          scrollContainer.scrollTo({ left: targetScrollLeft, behavior: 'smooth' });
        }, 50);
      }

      // Escuchar eventos en los botones de paginación
      paginationContainer.querySelectorAll('.pagination-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget;
          const page = parseInt(target.getAttribute('data-page') || '1');
          
          if (page !== currentPage && page >= 1 && page <= totalPages) {
            currentPage = page;
            renderProducts();
            
            // Scroll suave al inicio del catálogo
            document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
    }

    // Inicializar la primera renderización al cargar la página o restaurar estado
    const categoryToHighlight = currentCategory;
    if (categoryToHighlight && categoryToHighlight !== 'all') {
      const normalizedCat = normalizeCategory(categoryToHighlight);
      document.querySelectorAll('.cat-filter-btn').forEach(btn => {
        const normalizedBtnCat = normalizeCategory(btn.getAttribute('data-category'));
        if (normalizedBtnCat === normalizedCat) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    } else {
      document.querySelectorAll('.cat-filter-btn').forEach(btn => {
        const catName = btn.getAttribute('data-category');
        if (catName === 'all') {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    updateSubcategoriesUI();
    renderProducts();

    // Restaurar scroll si hay un estado previo (historial o sessionStorage)
    if (savedScrollY > 0) {
      setTimeout(() => {
        window.scrollTo(0, savedScrollY);
      }, 100);
    } else if (urlCategory) {
      // Scroll automático al catálogo si viene con categoría desde URL (navegación limpia)
      setTimeout(() => {
        document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
      }, 100);
    }

    // Guardar posición del scroll en el historial de forma debouncada
    let scrollTimeout;
    window.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        saveCatalogState();

        const url = new URL(window.location.href);
        const currentState = window.history.state || {};
        window.history.replaceState({
          ...currentState,
          category: currentCategory,
          subcategory: currentSubcategory,
          query: currentQuery,
          sort: currentSort,
          page: currentPage,
          scrollY: window.scrollY
        }, '', url.toString());
      }, 150);
    }, { passive: true });

    // Escuchar eventos personalizados del menú hamburguesa / navegación global
    window.addEventListener('filter-category-subcategory', (e) => {
      const { category, subcategory } = e.detail;
      currentCategory = category || 'all';
      currentSubcategory = subcategory || 'all';
      currentPage = 1;

      // Actualizar clases activas en los botones de categoría principal
      const normalizedCurrentCat = normalizeCategory(currentCategory);
      document.querySelectorAll('.cat-filter-btn').forEach(btn => {
        const normalizedBtnCat = normalizeCategory(btn.getAttribute('data-category'));
        if (normalizedBtnCat === normalizedCurrentCat) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      updateSubcategoriesUI();
      renderProducts();

      // Scroll suave al catálogo
      document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Evento del botón de añadir al carrito del Hero
    document.querySelector('.hero-add-cart-btn')?.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const id = target.getAttribute('data-id');
      const name = target.getAttribute('data-name');
      const price = parseFloat(target.getAttribute('data-price') || '0');
      const image = target.getAttribute('data-image');

      if (!id || !name) return;

      let cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const existingItem = cart.find(item => item.id === id);

      if (existingItem) {
        existingItem.quantity += 1;
      } else {
        cart.push({ id, name, price, image, quantity: 1 });
      }

      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));

      const orig = target.textContent || 'Añadir';
      target.textContent = '¡Añadido! ✓';
      target.style.backgroundColor = 'var(--success)';
      target.style.borderColor = 'var(--success)';
      
      setTimeout(() => {
        target.textContent = orig;
        target.style.backgroundColor = '';
        target.style.borderColor = '';
      }, 1500);
    });

    // Copiar cupón en Hero
    document.getElementById('copy-hero-promo-btn')?.addEventListener('click', (e) => {
      const targetBtn = e.currentTarget;
      const code = targetBtn.getAttribute('data-code') || 'APPLESEX20';
      
      navigator.clipboard.writeText(code).then(() => {
        const orig = targetBtn.textContent || 'Copiar';
        targetBtn.textContent = '¡Copiado! ✓';
        targetBtn.style.backgroundColor = 'var(--success)';
        targetBtn.style.borderColor = 'var(--success)';
        setTimeout(() => {
          targetBtn.textContent = orig;
          targetBtn.style.backgroundColor = '';
          targetBtn.style.borderColor = '';
        }, 2000);
      });
    });

  </script>
</Layout>
