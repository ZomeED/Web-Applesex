      "@id": "https://applesex-ecommerce.pages.dev/#store",
      "url": "https://applesex-ecommerce.pages.dev",
      "telephone": "+34690127039",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Calle Brazal 1",
        "addressLocality": "Churra",
        "addressRegion": "Murcia",
        "postalCode": "30110",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 38.0094, 
        "longitude": -1.1278
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "10:00",
          "closes": "13:30"
