            </div>
            
            {heroSettings.promoExclusions && (
              <span class="hero-exclusions" style="margin-bottom: 0;">
                {heroSettings.promoExclusions}
              </span>
            )}
          </div>
        ) : (
          <div>
            <h1 class="hero-title">
              {heroSettings.title}
            </h1>
            <p class="hero-description" style="margin-bottom: 0;">
              {heroSettings.subtitle}
            </p>
          </div>
        )}
      </div>



    </div>
  </section>


  <!-- Banner de Categorías y Descuento Premium (Diseño Mobile-First) -->
  <section class="promo-categories-banner" style="background: linear-gradient(180deg, #fbfafd 0%, #f6f2f7 100%); padding: 50px 0; color: var(--text-primary); position: relative; overflow: hidden; border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
    <!-- Elementos decorativos de fondo -->
    <div style="position: absolute; width: 250px; height: 250px; background: var(--primary); filter: blur(100px); opacity: 0.04; top: -10%; right: -5%; border-radius: 50%; z-index: 1; pointer-events: none;"></div>
    <div style="position: absolute; width: 200px; height: 200px; background: #885df1; filter: blur(90px); opacity: 0.03; bottom: -10%; left: -5%; border-radius: 50%; z-index: 1; pointer-events: none;"></div>
    
    <div class="container" style="position: relative; z-index: 2;">
      
