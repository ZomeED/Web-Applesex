              <path d="M12 2a4 4 0 0 0-4 4v6a4 4 0 0 0 8 0V6a4 4 0 0 0-4-4z"></path>
              <path d="M12 16v5"></path>
              <circle cx="12" cy="6" r="1" fill="#e45b9a"></circle>
            </svg>
          </div>
        </button>

        <!-- Categoría 2: Lencería -->
        <button class="pl-cat-card" data-category="LENCERÍA">
          <div class="pl-cat-bg" style="background-image: url('/images/cat-lenceria.jpg');"></div>
          <div class="pl-cat-content">
            <span class="pl-cat-subtext">viste</span>
            <span class="pl-cat-title">Lencería</span>
          </div>
