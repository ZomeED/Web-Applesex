    .pl-cat-card {
      position: relative;
      aspect-ratio: 1 / 1.06;
      background: #ffffff;
      border: none;
      border-radius: 18px;
      overflow: hidden;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 0;
      width: 100%;
      outline: none;
    }

    .pl-cat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
    }

    .pl-cat-card:active {
      transform: scale(0.97);
    }

    /* Mitad superior: Foto Lifestyle */
    .pl-cat-bg {
      height: 50%;
      width: 100%;
      background-size: cover;
      background-position: center;
      transition: transform 0.5s ease;
    }

    .pl-cat-card:hover .pl-cat-bg {
      transform: scale(1.06);
    }

    /* Mitad inferior: Fondo sólido pastel desaturado */
    .pl-cat-content {
      height: 50%;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      padding-bottom: 12px; /* Bajar un poco más el texto */
      transition: background-color 0.3s ease;
    }

    /* Colores pastel desaturados para el fondo inferior */
    .pl-cat-card[data-category="JUGUETES"] .pl-cat-content {
      background-color: #d1c8c5; /* Arcilla suave */
    }
    .pl-cat-card[data-category="LENCERÍA"] .pl-cat-content {
      background-color: #d2c8cb; /* Rosa viejo desaturado */
    }
    .pl-cat-card[data-category="ANAL"] .pl-cat-content {
      background-color: #e2dcd5; /* Arena suave desaturado */
    }
    .pl-cat-card[data-category="COSMÉTICA"] .pl-cat-content {
      background-color: #cbd3c6; /* Verde salvia desaturado */
    }
    .pl-cat-card[data-category="BDSM"] .pl-cat-content {
      background-color: #c8bfcb; /* Lila apagado desaturado */
    }
    .pl-cat-card[data-category="BIENESTAR"] .pl-cat-content {
      background-color: #c9d2ce; /* Menta grisácea desaturado */
    }

    .pl-cat-subtext {
      font-family: Georgia, serif;
      font-style: italic;
      font-size: 0.8rem; /* Tamaño reducido para mejor proporción */
      color: #554846;
      margin: 0 0 -2px 0; /* Juntar los textos reduciendo el espacio intermedio */
      line-height: 1.2;
    }

    .pl-cat-title {
      font-family: var(--font-title);
      font-weight: 800;
      font-size: 1.3rem; /* Ajustado ligeramente */
      color: #21121d;
      text-transform: lowercase;
      line-height: 1.1;
      margin: 0;
    }

    /* Insignia central flotante */
    .pl-cat-badge {
      position: absolute;
      top: 45%; /* Subido del 50% al 45% para dar más espacio al texto abajo */
      left: 50%;
      transform: translate(-50%, -50%);
      width: 46%; /* Reducido ligeramente de 50% para evitar superposición */
      height: 46%;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .pl-cat-card:hover .pl-cat-badge {
      transform: translate(-50%, -45%) scale(1.08); /* Mantener la alineación en hover */
    }

    /* Suave sombra de contacto elíptica y direccional (luz desde arriba-derecha hacia abajo-izquierda) */
    .pl-cat-shadow-base {
      position: absolute;
      bottom: 1%; /* Ligeramente más abajo de la base */
      left: 42%; /* Desplazada hacia la izquierda */
      transform: translateX(-50%) skewX(-24deg); /* Inclinada hacia la izquierda */
      width: 52%; /* Más ancha para representar la proyección */
      height: 10px; /* Un poco más de altura para la inclinación */
      background: rgba(16, 8, 14, 0.42); /* Sombra de contacto oscurecida a 0.42 para darle más peso y realismo */
      border-radius: 50%;
      filter: blur(5px); /* Reducido a 5px para mantener más definición en el punto de contacto */
      z-index: 5;
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* Al hacer hover la sombra se proyecta más lejos (se desplaza más a la izquierda, se encoge, difumina y atenúa) */
    .pl-cat-card:hover .pl-cat-shadow-base {
      transform: translateX(-65%) scale(0.6) skewX(-24deg);
      opacity: 0.38;
      filter: blur(8px);
    }

    .pl-cat-icon {
      position: relative;
      z-index: 10; /* Renderizarse por encima de la sombra */
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 0;
      transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      /* Sombra proyectada del producto desplazada a la izquierda (-8px) para alinearse con la sombra del suelo,
         y un sutil procesado fotográfico (saturación y brillo) para fundirse orgánicamente con el ambiente cálido de la foto */
      filter: drop-shadow(-8px 12px 14px rgba(0, 0, 0, 0.38)) brightness(0.96) contrast(1.03) saturate(0.98);
    }

    /* Efecto 3D pop-out: el producto flota hacia arriba y adelante al hacer hover */
    .pl-cat-card:hover .pl-cat-icon {
      transform: translateY(-10px) scale(1.2);
      filter: drop-shadow(-14px 20px 24px rgba(0, 0, 0, 0.45)) brightness(0.96) contrast(1.03) saturate(0.98);
