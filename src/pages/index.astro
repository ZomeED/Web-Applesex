          </div>
          <div class="pl-cat-badge">
            <div class="pl-cat-shadow-base"></div>
            <img src="/images/cat-cosmetica-icon.png" alt="Cosmética" class="pl-cat-icon" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <svg class="placeholder-svg-lotion" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#885df1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
