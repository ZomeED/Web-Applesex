          // B. Listener para los checkboxes de Subcategorías (Desktop + Mobile)
          document.querySelectorAll('.sidebar-subcat-checkbox').forEach(cb => {
            cb.addEventListener('change', (e) => {
              const target = e.target as HTMLInputElement;
              const val = target.value;
              if (target.checked) {
                if (!selectedSubcategories.includes(val)) {
                  selectedSubcategories.push(val);
                }
              } else {
                selectedSubcategories = selectedSubcategories.filter(x => x !== val);
              }

              // Sincronizar todos los checkboxes con el mismo valor (desktop/mobile)
              document.querySelectorAll(`.sidebar-subcat-checkbox[value="${val}"]`).forEach(el => {
                (el as HTMLInputElement).checked = target.checked;
              });

              renderSidebarFilters();
              renderSidebarMaterialsAndCharacteristics();
              renderSidebarStimulation();
              renderSearchResults();
