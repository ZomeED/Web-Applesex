    <style is:global>
      /* Header principal */
      .main-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.98); /* Increased opacity for mobile scroll coverage */
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04); /* More defined shadow to hide elements sliding behind */
      }

      .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
        gap: 16px;
      }

      .header-cart-btn {
        padding: 8px 14px;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        min-height: 40px;
        background: #ffffff;
        border: 1px solid var(--border-color);
        color: var(--text-primary);
      }
      .header-cart-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: #fcf0f5;
      }
      .cart-counter-badge {
        background: var(--primary);
        color: white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
      }

      /* Botón disparador del buscador en Header */
      .search-trigger-btn {
        background: #f2eff6;
        border: 1px solid var(--border-color);
        color: var(--text-secondary);
        padding: 8px 16px;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.25s ease;
        width: 220px;
        min-height: 40px;
      }
      .search-trigger-btn:hover, .search-trigger-btn:active {
        background: #ffffff;
        border-color: var(--primary);
        color: var(--text-primary);
        box-shadow: 0 0 15px rgba(216, 75, 140, 0.2);
      }

      .search-trigger-text {
        flex-grow: 1;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .search-trigger-mobile-label {
        display: none;
      }

      @media (max-width: 768px) {
        .desktop-nav {
          display: none !important;
        }
        .search-trigger-btn {
          width: auto;
          padding: 8px 14px;
          background: rgba(216, 75, 140, 0.1);
          border-color: rgba(216, 75, 140, 0.3);
          color: var(--text-primary);
        }
        .search-trigger-text {
          display: none;
        }
        .search-trigger-mobile-label {
          display: inline;
          font-size: 0.85rem;
          font-weight: 600;
        }
        .desktop-only-hint {
          display: none !important;
        }
