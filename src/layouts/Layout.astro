      // Renderizar resultados con resaltado de coincidencias
      function renderSearchResults() {
        if (!resultsGrid || !resultsCount) return;
        
        // Limpiar observadores de scroll anteriores para evitar fugas de memoria
        if (searchIntersectionObserver) {
          searchIntersectionObserver.disconnect();
          searchIntersectionObserver = null;
        }

        const query = searchInput ? searchInput.value.trim().toLowerCase() : '';

        // Filtrar productos con soporte fuzzy y subcategoría
        let filtered = allProducts.filter(p => productMatchesFilters(p, query));

        // Ordenar con soporte robusto para valores numéricos y alfabéticos
        if (activeSort === 'default') {
          filtered.sort((a, b) => {
            const featA = a.isFeatured ? 1 : 0;
            const featB = b.isFeatured ? 1 : 0;
            if (featA !== featB) {
              return featB - featA;
            }
            return (a.name || '').localeCompare(b.name || '');
          });
        } else if (activeSort === 'price-asc') {
          filtered.sort((a, b) => {
            const priceA = parseFloat(a.price) || 0;
            const priceB = parseFloat(b.price) || 0;
            return priceA - priceB;
          });
        } else if (activeSort === 'price-desc') {
          filtered.sort((a, b) => {
            const priceA = parseFloat(a.price) || 0;
            const priceB = parseFloat(b.price) || 0;
            return priceB - priceA;
          });
        } else if (activeSort === 'name-asc') {
          filtered.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
        }

        // Update all sidebar filter counts and top subcategories chips reactively
        renderSidebarFilters();
        renderSidebarMaterialsAndCharacteristics();
        renderSidebarStimulation();
        renderSidebarBrands();
        updateModalSubcategoriesUI();

        if (filtered.length === 0) {
          resultsCount.style.display = 'block';
          resultsCount.textContent = `Sin resultados para "${query}"`;
          const filteredCountEl = document.getElementById('modal-filtered-count');
          if (filteredCountEl) filteredCountEl.textContent = '0';
          resultsGrid.innerHTML = `
            <div style="text-align: center; padding: 40px 16px;">
              <div style="margin-bottom: 16px; color: var(--text-secondary);">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </div>
              <h4 style="font-size: 1.1rem; margin-bottom: 8px;">No encontramos ningún producto</h4>
              <p style="color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 16px;">Prueba con otra palabra como "vibrador", "aceite" o borra la categoría.</p>
              <button id="reset-search-modal-filters" class="btn btn-secondary" style="font-size: 0.85rem; padding: 10px 18px; border-radius: 50px;">Ver todo el catálogo</button>
            </div>
          `;

          const resetBtn = document.getElementById('reset-search-modal-filters');
          if (resetBtn) {
            resetBtn.addEventListener('click', () => {
              if (searchInput) searchInput.value = '';
              activeCategory = 'all';
              activeSubcategory = 'all';
              activeSort = 'default';
              activeMinPrice = 0;
              activeMaxPrice = 150;
              selectedSubcategories = [];
              selectedBrands = [];
              if (sortSelect) sortSelect.value = 'default';
              if (priceMinSlider) priceMinSlider.value = '0';
              if (priceMinSliderVal) priceMinSliderVal.textContent = '0€';
              if (priceMaxSlider) priceMaxSlider.value = '150';
              if (priceMaxSliderVal) priceMaxSliderVal.textContent = 'Sin límite';
              if (mobilePriceMinSlider) mobilePriceMinSlider.value = '0';
              if (mobilePriceMinSliderVal) mobilePriceMinSliderVal.textContent = '0€';
              if (mobilePriceMaxSlider) mobilePriceMaxSlider.value = '150';
              if (mobilePriceMaxSliderVal) mobilePriceMaxSliderVal.textContent = 'Sin límite';
              document.querySelectorAll('.modal-cat-btn').forEach(b => b.classList.remove('active'));
              document.querySelector('.modal-cat-btn[data-cat="all"]')?.classList.add('active');
              activeSubSubCategory = 'all';
              selectedMaterials = [];
              selectedCharacteristics = [];
              selectedStimulations = [];
              updatePriceSliderTracks();
              renderSearchResults();
            });
          }
          return;
        }

        resultsCount.style.display = 'block';
        resultsCount.textContent = `Resultados: ${filtered.length}`;

        const filteredCountEl = document.getElementById('modal-filtered-count');
        if (filteredCountEl) filteredCountEl.textContent = filtered.length.toString();

        const visibleProducts = filtered.slice(0, visibleResultsLimit);
        let gridHtml = visibleProducts.map(p => {
          let highlightedTitle = highlightText(p.name, query);
          let subtitle = getProductSubtitle(p);
          let highlightedDesc = highlightText(subtitle, query);

          const currentPrice = p.price;
          const oldPrice = p.oldPrice;

          return `
            <article class="search-item-card">
              <a href="/producto/${p.slug}" style="text-decoration: none; color: inherit; display: flex; flex-direction: column; height: 100%;">
                <div class="search-item-img-container">
                  <img src="${p.image}" alt="${p.name}" class="search-item-img" loading="lazy" />
                </div>
                <div class="search-item-info">
                  <h4 class="search-item-title">${highlightedTitle}</h4>
                  <p class="search-item-desc">${highlightedDesc}</p>
                  <div class="search-item-price-container">
                    ${oldPrice ? `
                      <span class="search-item-price-old">${oldPrice}€</span>
                    ` : ''}
                    <span class="search-item-price-current">${currentPrice}€</span>
                  </div>
                </div>
              </a>
            </article>
          `;
        }).join('');

        if (filtered.length > visibleResultsLimit) {
          gridHtml += `
            <div id="search-infinite-scroll-trigger" style="grid-column: 1 / -1; display: flex; justify-content: center; align-items: center; padding: 24px 0 40px 0; width: 100%; min-height: 50px;">
              <span class="search-scroll-spinner" style="width: 24px; height: 24px; border: 2.5px solid rgba(216, 75, 140, 0.2); border-top-color: var(--primary); border-radius: 50%; display: inline-block; animation: spin-search-loader 0.8s linear infinite;"></span>
            </div>
          `;
        }

        resultsGrid.innerHTML = gridHtml;

        // Configurar el observador de intersección para scroll infinito
        if (filtered.length > visibleResultsLimit) {
          const triggerEl = document.getElementById('search-infinite-scroll-trigger');
          if (triggerEl) {
            searchIntersectionObserver = new IntersectionObserver((entries) => {
              if (entries[0].isIntersecting) {
                visibleResultsLimit += 24;
                renderSearchResults();
              }
            }, {
              // Observamos dentro del contenedor scrollable de resultados
              root: document.querySelector('.search-results-content') || null,
              // rootMargin de 150px carga el lote siguiente antes de que el usuario llegue abajo del todo
              rootMargin: '150px',
            });
            searchIntersectionObserver.observe(triggerEl);
          }
        }

        saveSearchState();
      }

      // Script para actualizar el contador de carrito
      function updateHeaderCart() {
        const cart = JSON.parse(localStorage.getItem('cart') || '[]');
        const count = cart.reduce((total: number, item: any) => total + item.quantity, 0);
        const counterEl = document.getElementById('cart-counter');
        if (counterEl) {
          counterEl.textContent = count.toString();
        }
      }
      window.addEventListener('cart-updated', updateHeaderCart);
      updateHeaderCart();

      // Lógica de la barra de anuncios descartable
      const promoBar = document.getElementById('promo-announcement-bar');
      const closePromoBtn = document.getElementById('close-promo-bar');
      const copyPromoBtn = document.getElementById('copy-promo-code');
      const promoTextEl = document.getElementById('promo-text-content');
      
      if (promoBar && closePromoBtn) {
        if (sessionStorage.getItem('promo-bar-dismissed') === 'true') {
          promoBar.style.display = 'none';
        }
        
        closePromoBtn.addEventListener('click', () => {
          promoBar.style.display = 'none';
          sessionStorage.setItem('promo-bar-dismissed', 'true');
        });
      }

      if (promoTextEl) {
        promoTextEl.addEventListener('click', (e: any) => {
          const copyBtn = e.target.closest('#copy-promo-code');
          if (copyBtn) {
            const code = copyBtn.textContent ? copyBtn.textContent.trim() : 'APPLESEX20';
            navigator.clipboard.writeText(code).then(() => {
              const originalHTML = promoTextEl.innerHTML;
              promoTextEl.innerHTML = `Código <strong>${code}</strong> copiado al portapapeles`;
              setTimeout(() => {
                promoTextEl.innerHTML = originalHTML;
              }, 2500);
            });
          }
        });
      }

      // Lógica del menú lateral móvil (Hamburger drawer)
      const mobileDrawer = document.getElementById('mobile-menu-drawer');
      const hamburgerBtn = document.getElementById('mobile-hamburger-btn');
      const closeDrawerBtn = document.getElementById('close-mobile-drawer-btn');
      const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');

      function openMobileDrawer() {
        if (!mobileDrawer || !hamburgerBtn) return;
        mobileDrawer.style.display = 'flex';
        mobileDrawer.offsetHeight; // Forzar reflujo para que se aplique la transición
        mobileDrawer.classList.add('open');
        hamburgerBtn.classList.add('open');
        hamburgerBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeMobileDrawer() {
        if (!mobileDrawer || !hamburgerBtn) return;
        mobileDrawer.classList.remove('open');
        hamburgerBtn.classList.remove('open');
        hamburgerBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        setTimeout(() => {
          if (!mobileDrawer.classList.contains('open')) {
            mobileDrawer.style.display = 'none';
          }
        }, 300);
      }

      if (hamburgerBtn) {
        hamburgerBtn.addEventListener('click', () => {
          if (mobileDrawer?.classList.contains('open')) {
            closeMobileDrawer();
          } else {
            openMobileDrawer();
          }
        });
      }

      if (closeDrawerBtn) closeDrawerBtn.addEventListener('click', closeMobileDrawer);
      if (drawerBackdrop) drawerBackdrop.addEventListener('click', closeMobileDrawer);

      // Cerrar drawer al clickear enlaces directos de la misma página
      document.querySelectorAll('.drawer-close-on-click').forEach(link => {
        link.addEventListener('click', closeMobileDrawer);
      });

      // Lógica de Acordeón de Categorías en el Drawer Hamburguesa
      document.querySelectorAll('.drawer-cat-toggle').forEach(toggle => {
        toggle.addEventListener('click', (e) => {
          const cat = toggle.getAttribute('data-cat');
          const group = toggle.closest('.drawer-cat-group');
          const container = group.querySelector('.drawer-subcat-container');
          const list = group.querySelector('.drawer-subcat-list');

          if (!container || !list) return;

          const isOpen = toggle.classList.contains('active');

          // Cerrar los otros acordeones para mantener el menú ordenado
          document.querySelectorAll('.drawer-cat-toggle').forEach(t => {
            if (t !== toggle && t.classList.contains('active')) {
              t.classList.remove('active');
              const g = t.closest('.drawer-cat-group');
              const c = g.querySelector('.drawer-subcat-container');
              const l = g.querySelector('.drawer-subcat-list');
              if (c && l) {
                c.style.height = '0px';
                l.style.opacity = '0';
                l.style.transform = 'translateY(-5px)';
              }
            }
          });

          if (isOpen) {
            toggle.classList.remove('active');
            container.style.height = '0px';
            list.style.opacity = '0';
            list.style.transform = 'translateY(-5px)';
          } else {
            toggle.classList.add('active');
            container.style.height = list.scrollHeight + 'px';
            list.style.opacity = '1';
            list.style.transform = 'translateY(0)';
          }
        });
      });

      // Escuchar clicks de subcategorías en el drawer para abrir el buscador modal filtrado
      document.querySelectorAll('.drawer-subcat-item').forEach(item => {
        item.addEventListener('click', (e) => {
          e.preventDefault();
          closeMobileDrawer();

          const cat = item.getAttribute('data-cat') || 'all';
          const sub = item.getAttribute('data-sub') || 'all';

          initializeSearchState(cat, sub);
          if (sub !== 'all' && !selectedSubcategories.includes(sub)) {
            selectedSubcategories.push(sub);
          }

          // Limpiar texto de búsqueda anterior
          if (searchInput) searchInput.value = '';

          openModal();
          renderSidebarFilters();
          renderSearchResults();
        });
      });

      // Escuchar clicks de burbujas de categoría en la Home para abrir el buscador modal
      document.querySelectorAll('.category-bubble-item, .pl-cat-card').forEach(item => {
        item.addEventListener('click', (e) => {
          e.preventDefault();
          closeMobileDrawer();

          const cat = item.getAttribute('data-category') || 'all';

          initializeSearchState(cat, 'all');

          if (searchInput) searchInput.value = '';

          openModal();
          renderSearchResults();
        });
      });

      // Escuchar clicks en todos los enlaces de "Catálogo Completo" para abrir el buscador modal completo
      document.querySelectorAll('a[href="/#catalogo"], a[href="#catalogo"], #nav-catalogo-link, #banner-explore-all-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          closeMobileDrawer();

          initializeSearchState('all', 'all');

          if (searchInput) searchInput.value = '';

          openModal();
          renderSearchResults();
        });
      });

      function saveSearchState() {
        const resultsGridEl = document.getElementById('modal-results-grid');
        const state = {
          isOpen: modalBackdrop && modalBackdrop.style.display === 'flex',
          category: activeCategory,
          selectedCategories,
          subcategory: activeSubcategory,
          subSubCategory: activeSubSubCategory,
          selectedSubcategories,
          selectedBrands,
          selectedMaterials,
          selectedCharacteristics,
          selectedStimulations,
          minPrice: activeMinPrice,
          maxPrice: activeMaxPrice,
          sort: activeSort,
          query: searchInput ? searchInput.value : '',
          scrollY: resultsGridEl ? resultsGridEl.scrollTop : 0
        };
        sessionStorage.setItem('applesex_search_state', JSON.stringify(state));
      }

      if (resultsGrid) {
        let gridScrollTimeout;
        resultsGrid.addEventListener('scroll', () => {
          clearTimeout(gridScrollTimeout);
          gridScrollTimeout = setTimeout(() => {
            saveSearchState();
          }, 100);
        }, { passive: true });
      }

      // Cargar estado guardado del buscador modal al iniciar la página
      const savedSearchStateText = sessionStorage.getItem('applesex_search_state');
      let savedSearchState = null;
      if (savedSearchStateText) {
        try {
          savedSearchState = JSON.parse(savedSearchStateText);
        } catch (e) {}
      }

      if (savedSearchState) {
        activeCategory = savedSearchState.category || 'all';
        selectedCategories = savedSearchState.selectedCategories || [];
        activeSubcategory = savedSearchState.subcategory || 'all';
        activeSubSubCategory = savedSearchState.subSubCategory || 'all';
        selectedSubcategories = savedSearchState.selectedSubcategories || [];
        selectedBrands = savedSearchState.selectedBrands || [];
        selectedMaterials = savedSearchState.selectedMaterials || [];
        selectedCharacteristics = savedSearchState.selectedCharacteristics || [];
        selectedStimulations = savedSearchState.selectedStimulations || [];
        activeMinPrice = typeof savedSearchState.minPrice === 'number' ? savedSearchState.minPrice : 0;
        activeMaxPrice = typeof savedSearchState.maxPrice === 'number' ? savedSearchState.maxPrice : 150;
        activeSort = savedSearchState.sort || 'default';
        
        if (searchInput && savedSearchState.query) {
          searchInput.value = savedSearchState.query;
          const clearBtn = document.getElementById('modal-clear-input');
          if (clearBtn) clearBtn.style.display = 'block';
        }
        if (sortSelect) sortSelect.value = activeSort;
        if (priceMinSlider) {
          priceMinSlider.value = activeMinPrice.toString();
          if (priceMinSliderVal) priceMinSliderVal.textContent = activeMinPrice + '€';
        }
        if (priceMaxSlider) {
          priceMaxSlider.value = activeMaxPrice.toString();
          if (priceMaxSliderVal) priceMaxSliderVal.textContent = activeMaxPrice === 150 ? 'Sin límite' : activeMaxPrice + '€';
        }
        if (mobilePriceMinSlider) {
          mobilePriceMinSlider.value = activeMinPrice.toString();
          if (mobilePriceMinSliderVal) mobilePriceMinSliderVal.textContent = activeMinPrice + '€';
        }
        if (mobilePriceMaxSlider) {
          mobilePriceMaxSlider.value = activeMaxPrice.toString();
          if (mobilePriceMaxSliderVal) mobilePriceMaxSliderVal.textContent = activeMaxPrice === 150 ? 'Sin límite' : activeMaxPrice + '€';
        }

        if (savedSearchState.isOpen && modalBackdrop && !window.location.pathname.includes('/producto/') && !window.location.pathname.includes('/carrito')) {
          productsLoadedPromise.then(() => {
            modalBackdrop.style.display = 'flex';
            document.body.style.overflow = 'hidden';
            updatePriceSliderTracks();
            renderSidebarFilters();
            renderSidebarMaterialsAndCharacteristics();
            renderSidebarStimulation();
            renderSidebarBrands();
            renderSearchResults();
            
            if (savedSearchState.scrollY && resultsGrid) {
              setTimeout(() => {
                resultsGrid.scrollTop = savedSearchState.scrollY;
              }, 200);
            }
          });
        }
      }

      // Limpiar estados cuando el usuario inicia una navegación fresca a la página principal
      document.querySelectorAll('a[href="/"]').forEach(link => {
        link.addEventListener('click', () => {
          sessionStorage.removeItem('applesex_catalog_state');
          sessionStorage.removeItem('applesex_search_state');
        });
      });



      // Listener robusto con delegación de eventos para el botón flotante de filtros en móvil
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest('#mobile-floating-filter-btn');
        if (btn) {
          e.preventDefault();
          console.log('[mobile-floating-filter-btn] Clicked!');
          if (!modalBackdrop || modalBackdrop.style.display !== 'flex') {
            console.log('[mobile-floating-filter-btn] Opening modal first...');
            openModal();
          }
          console.log('[mobile-floating-filter-btn] Opening mobile filters drawer...');
          openMobileFilters();
        }
      });
    </script>



    <!-- Botón Flotante de WhatsApp Premium -->
    {!hideWhatsApp && (
      <a 
        href="https://wa.me/34690127039" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="whatsapp-floating-btn"
        aria-label="Chatear por WhatsApp"
      >
        <img src="/images/WhatsApp.svg" alt="WhatsApp" style="width: 32px; height: 32px; display: block;" />
      </a>
    )}
  </body>
</html>
