          // C. Listener para Contraer/Expandir dinámicamente las subcategorías en Desktop
          document.querySelectorAll('.toggle-dynamic-subcat').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const t = e.currentTarget as HTMLElement;
              const parent = t.closest('.dynamic-subcat-section');
              const list = parent?.querySelector('.dynamic-subcat-list') as HTMLElement;
              if (list) {
                if (list.style.display === 'none') {
                  list.style.display = 'flex';
                  t.textContent = 'Contraer ↑';
                } else {
                  list.style.display = 'none';
                  t.textContent = 'Expandir ↓';
                }
              }
            });
          });
        });
      }

