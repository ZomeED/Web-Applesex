                <button type="button" class="toggle-dynamic-subcat" style="background: transparent; border: none; font-size: 0.68rem; color: var(--primary); cursor: pointer; font-weight: 700; outline: none; transition: opacity 0.2s;">Contraer ↑</button>
              </div>
              <div class="dynamic-subcat-list" style="display: flex; flex-direction: column; gap: 6px; transition: all 0.3s ease; overflow: hidden;">
