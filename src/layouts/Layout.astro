---
import '../styles/global.css';
import { sanityClient, isSanityConfigured } from '../db/sanity';

interface Props {
  title: string;
  description: string;
  image?: string;
  hideWhatsApp?: boolean;
  hideHeaderFooter?: boolean;
}

const { title, description, image, hideWhatsApp = false, hideHeaderFooter = false } = Astro.props;

const shareImage = image || '/logo.png';
const absoluteShareImage = new URL(shareImage, Astro.url).href;

let announcementText = '¡Inauguración! <strong>20% Dto.</strong> en toda la web con el código <strong id="copy-promo-code" style="text-decoration: underline; color: #ffffff; cursor: pointer; padding: 2px 6px; border: 1px dashed #ffffff; border-radius: 4px; margin-left: 4px; display: inline-block;" title="Haz clic para copiar">APPLESEX20</strong>';

if (isSanityConfigured()) {
  try {
    const settings = await sanityClient.fetch(`*[_type == "homepageSettings"][0] { announcementText }`);
    if (settings && settings.announcementText) {
      announcementText = settings.announcementText;
    }
  } catch (error) {
    console.warn('Error loading announcement text from Sanity:', error);
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <!-- SEO & Favicon Oficial AppleSex -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title ? `${title} | AppleSex` : "Tienda Online de Juguetes Eróticos - Applsex | AppleSex"}</title>
    <meta name="description" content={description || "Descubre Applesex, tu tienda online de juguetes eróticos con más de 10 años de experiencia. Explora nuestro amplio catálogo y encuentra los productos perfectos para ti. ¡Compra hoy y disfruta de una experiencia única!"} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#d60068" />
    <meta property="og:title" content={title ? `${title} | AppleSex` : "Boutique Erótica Premium y Bienestar Íntimo | AppleSex"} />
    <meta property="og:description" content={description || "Encuentra juguetes eróticos, cosmética sensual y lencería premium. Envíos 100% discretos y confidenciales en 24h o recogida en 2h en Murcia."} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="AppleSex" />
    <meta property="og:image" content={absoluteShareImage} />
    <meta property="og:image:secure_url" content={absoluteShareImage} />
    <meta property="og:locale" content="es_ES" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? `${title} | AppleSex` : "Boutique Erótica Premium y Bienestar Íntimo | AppleSex"} />
    <meta name="twitter:description" content={description || "Encuentra juguetes eróticos, cosmética sensual y lencería premium. Envíos 100% discretos y confidenciales en 24h o recogida en 2h en Murcia."} />
    <meta name="twitter:image" content={absoluteShareImage} />
  </head>
  <body>
    <!-- Barra de Anuncios Superior Elegante y Descartable -->
    {!hideHeaderFooter && (
      <div id="promo-announcement-bar" style="background: linear-gradient(90deg, #c43b7a, #ed6daa); color: white; padding: 8px 20px; font-size: 0.82rem; font-weight: 500; text-align: center; display: flex; align-items: center; justify-content: center; position: relative; z-index: 101; transition: var(--transition-smooth);">
        <span id="promo-text-content" style="flex-grow: 1; padding-right: 18px;" set:html={announcementText}>
        </span>
        <button id="close-promo-bar" style="background: transparent; border: none; color: white; cursor: pointer; font-size: 1.1rem; padding: 4px 8px; display: inline-flex; align-items: center; position: absolute; right: 10px;" aria-label="Cerrar aviso">
          ✕
        </button>
      </div>
    )}

    <!-- Encabezado con efecto cristal esmerilado -->
    {!hideHeaderFooter && (
      <header class="glass main-header" style="position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--border-color);">
        <div class="container" style="display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 12px;">
          
          <div style="display: flex; align-items: center; gap: 12px;">
            <!-- Botón de Hamburguesa Móvil (Visible solo en móvil) -->
            <button id="mobile-hamburger-btn" class="hamburger-btn" aria-label="Abrir menú de navegación" aria-expanded="false">
              <span class="hamburger-line"></span>
              <span class="hamburger-line"></span>
              <span class="hamburger-line"></span>
            </button>
            
            <a href="/" id="header-logo-link" style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
              <img src="/logo.png" alt="AppleSex - Tienda Online de Juguetes Eróticos" style="height: 44px; width: auto; object-fit: contain; mix-blend-mode: multiply;" />
            </a>
          </div>

          <nav class="desktop-nav" style="display: flex; align-items: center; gap: 28px;">
            <a href="/#catalogo" id="nav-catalogo-link" style="font-size: 0.95rem; font-weight: 500; color: var(--text-secondary);">Catálogo</a>
            <a href="/#envios" id="nav-envios-link" style="font-size: 0.95rem; font-weight: 500; color: var(--text-secondary);">Envíos & Recogida</a>
            <a href="/#contacto" id="nav-contacto-link" style="font-size: 0.95rem; font-weight: 500; color: var(--text-secondary);">Contacto</a>
          </nav>

          <!-- Buscador Móvil y Desktop Integrado -->
          <div style="display: flex; align-items: center; gap: 8px;">
            <button id="open-search-modal-btn" class="search-trigger-btn" aria-label="Abrir buscador de productos">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span class="search-trigger-text">Buscar productos...</span>
              <span class="search-trigger-mobile-label">Buscar</span>
            </button>

            <!-- Widget del Carrito -->
            <a href="/carrito" id="header-cart-button" class="btn btn-secondary header-cart-btn" aria-label="Ver carrito">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
              <span id="cart-counter" class="cart-counter-badge">0</span>
            </a>
          </div>
        </div>
      </header>
    )}

    <!-- Modal de Búsqueda Flotante de Pantalla Completa (Mobile-First 100% Optimizado) -->
    <div id="search-modal-backdrop" class="search-backdrop" style="display: none;">
      <div class="search-modal-container">
        
        <!-- Input Principal de Búsqueda -->
        <div class="search-modal-header">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="modal-search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="modal-search-input" 
            placeholder="¿Qué estás buscando hoy?" 
            autocomplete="off"
            inputmode="search"
          />
          <button id="modal-clear-input" class="search-clear-btn" style="display: none;" title="Limpiar texto">✕</button>
          <button id="close-search-modal-btn" class="search-close-btn" aria-label="Cerrar buscador"><span class="close-text-desktop">Cerrar </span>✕</button>
        </div>

        <!-- Barra de Filtros Rápidos por Categoría (Scroll Táctil Suave) -->
        <div class="search-modal-categories" id="modal-category-filters" style="align-items: center;">
          <button class="modal-cat-btn modal-cat-all-btn active" data-cat="all">Ver todo</button>
          <button class="modal-cat-btn" data-cat="JUGUETES">Juguetes</button>
          <button class="modal-cat-btn" data-cat="LENCERÍA">Lencería</button>
          <button class="modal-cat-btn" data-cat="ANAL">Anal</button>
          <button class="modal-cat-btn" data-cat="COSMÉTICA">Cosmética</button>
          <button class="modal-cat-btn" data-cat="BDSM">BDSM</button>
          <button class="modal-cat-btn" data-cat="BIENESTAR">Bienestar</button>
        </div>

        <!-- Subcategorías Desplegables en el Buscador Modal con Transición Suave -->
        <div class="modal-subcategory-filter-wrapper" id="modal-subcategory-filter-wrapper">
          <div class="modal-subcategory-filter-chips" id="modal-subcategory-filter-chips"></div>
        </div>
 
        <!-- Sub-subcategorías (Quick Filters para Dildos y específicos) -->
        <div class="modal-subsubcategory-filter-wrapper" id="modal-subsubcategory-filter-wrapper" style="display: none; padding: 10px 20px; border-bottom: 1px solid var(--border-color); background: #fafafa; flex-shrink: 0; overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch; scrollbar-width: none;">
          <div class="modal-subsubcategory-filter-chips" id="modal-subsubcategory-filter-chips" style="display: flex; gap: 8px;"></div>
        </div>



        <!-- Resumen de Resultados -->
        <div id="modal-results-summary" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; border-bottom: 1px solid var(--border-color); font-size: 0.88rem; color: var(--text-secondary); background: #ffffff; flex-shrink: 0;">
          <span id="modal-results-count">Resultados: 0</span>
          <div style="display: flex; align-items: center; gap: 12px;">
            <button id="mobile-filter-trigger-btn" style="background: var(--primary-light, #fcf0f5); border: 1px solid var(--border-color); border-radius: 20px; padding: 6px 14px; font-size: 0.82rem; font-weight: 700; color: var(--primary); display: none; align-items: center; gap: 6px; cursor: pointer; transition: all 0.2s ease;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
              Filtrar
            </button>
            <div class="modal-sort-wrapper" style="display: flex; align-items: center; gap: 6px;">
              <label for="modal-sort-select" class="modal-sort-label">Ordenar:</label>
              <select id="modal-sort-select" style="background: transparent; border: none; font-size: 0.85rem; font-weight: 600; color: var(--text-primary); cursor: pointer; outline: none; padding-right: 4px;">
                <option value="default">Destacados</option>
                <option value="price-asc">Precio: más bajo</option>
                <option value="price-desc">Precio: más alto</option>
                <option value="name-asc">Nombre: A - Z</option>
              </select>
          </div>
        </div>
      </div>

        <!-- Contenedor Principal de Búsqueda -->
        <div class="search-main-layout">
          <!-- Sidebar de Filtros (Solo visible en Desktop) -->
          <aside class="search-filters-sidebar">
             <!-- Rango de Precio -->
             <div class="filter-section" style="margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
               <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                 <h4 style="font-size: 0.78rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title); margin: 0;">Rango de Precio</h4>
                 <div style="font-size: 0.75rem; color: var(--primary); font-weight: 700;">
                   <span id="modal-price-min-val">0€</span> - <span id="modal-price-max-val">Sin límite</span>
                 </div>
               </div>
               <div class="double-slider-container">
                 <div class="slider-track" id="modal-slider-track"></div>
                 <input type="range" id="modal-price-min-slider" min="0" max="150" step="5" value="0" />
                 <input type="range" id="modal-price-max-slider" min="0" max="150" step="5" value="150" />
               </div>
             </div>

              <!-- CATEGORÍA Fijo (Multi-select) -->
              <div id="modal-filter-main-categories-section" class="filter-section" style="margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <h4 style="font-size: 0.78rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title); margin: 0;">Categoría</h4>
                  <button type="button" id="toggle-filter-main-categories" style="background: transparent; border: none; font-size: 0.68rem; color: var(--primary); cursor: pointer; font-weight: 700; outline: none; transition: opacity 0.2s;">Contraer ↑</button>
                </div>
                <div id="modal-sidebar-main-categories-list" style="display: flex; flex-direction: column; gap: 6px; transition: all 0.3s ease; overflow: hidden;">
                  <!-- Inyectado dinámicamente con JS -->
                </div>
              </div>

              <!-- Subcategorías Dinámicas de las Categorías Seleccionadas -->
              <div id="modal-filter-subcategories-container"></div>

             <!-- Material (Solo visible cuando se selecciona dildos) -->
             <div id="modal-filter-material-section" class="filter-section" style="margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color); display: none;">
               <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                 <h4 style="font-size: 0.78rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title); margin: 0;">Material</h4>
                 <button type="button" id="toggle-filter-materials" style="background: transparent; border: none; font-size: 0.68rem; color: var(--primary); cursor: pointer; font-weight: 700; outline: none; transition: opacity 0.2s;">Contraer ↑</button>
               </div>
               <div id="modal-sidebar-materials-list" style="display: flex; flex-direction: column; gap: 6px; transition: all 0.3s ease; overflow: hidden;">
                 <!-- Inyectado dinámicamente con JS -->
               </div>
             </div>

             <!-- Tipo de Estimulación (Solo visible para Juguetes > Succionadores y Estimuladores) -->
             <div id="modal-filter-stimulation-section" class="filter-section" style="margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color); display: none;">
               <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                 <h4 style="font-size: 0.78rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title); margin: 0;">Tipo de Estimulación</h4>
                 <button type="button" id="toggle-filter-stimulation" style="background: transparent; border: none; font-size: 0.68rem; color: var(--primary); cursor: pointer; font-weight: 700; outline: none; transition: opacity 0.2s;">Contraer ↑</button>
               </div>
               <div id="modal-sidebar-stimulation-list" style="display: flex; flex-direction: column; gap: 6px; transition: all 0.3s ease; overflow: hidden;">
                 <!-- Inyectado dinámicamente con JS -->
               </div>
             </div>

             <!-- Características (Solo visible cuando se selecciona dildos) -->
             <!-- Contenedor dinámico de secciones de sub-subcategorías (ej. Tipo de Vibrador, Tipo de Dildo) -->
             <div id="modal-filter-characteristics-sections-container"></div>

             <!-- Marcas -->
             <div class="filter-section" style="margin-bottom: 14px;">
               <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                 <h4 style="font-size: 0.78rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title);">Marca</h4>
                 <button type="button" id="toggle-filter-brands" style="background: transparent; border: none; font-size: 0.68rem; color: var(--primary); cursor: pointer; font-weight: 700; outline: none; transition: opacity 0.2s;">Contraer ↑</button>
               </div>
               <div id="modal-sidebar-brands-list" style="display: flex; flex-direction: column; gap: 6px; transition: all 0.3s ease; overflow: hidden;">
                 <!-- Inyectado dinámicamente con JS -->
               </div>
             </div>
          </aside>

          <!-- Resultados (Derecha) -->
          <div class="search-results-content">
            <div id="modal-results-grid" class="search-results-grid"></div>
          </div>
        </div>

        <!-- Footer del Modal -->
        <div class="search-modal-footer">
          <span id="modal-footer-stats">Mostrando <strong id="modal-filtered-count">0</strong> de <strong id="modal-total-count">0</strong> productos</span>
          <span class="desktop-only-hint">Presiona <kbd>ESC</kbd> para salir</span>
        </div>

      </div>

      <!-- Botón Flotante de Filtros Móvil (Lado izquierdo) -->
      <button 
        id="mobile-floating-filter-btn" 
        class="mobile-floating-filter-btn"
        aria-label="Filtrar resultados"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
          <line x1="1" y1="14" x2="7" y2="14"></line>
          <line x1="9" y1="8" x2="15" y2="8"></line>
          <line x1="17" y1="16" x2="23" y2="16"></line>
        </svg>
        <span>Filtrar</span>
      </button>
    </div>

    <!-- Modal Parcial de Filtros para Móviles (Bottom Sheet) -->
    <div id="mobile-filter-drawer" class="mobile-filter-drawer-backdrop" style="display: none;">
      <div class="mobile-filter-drawer-container">
        <div class="mobile-filter-drawer-header">
          <h3>Filtros</h3>
          <button id="close-mobile-filters-btn" class="close-drawer-btn">✕</button>
        </div>
        <div class="mobile-filter-drawer-body">
           <!-- Rango de Precio -->
            <div class="filter-section" style="margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <h4 style="font-size: 0.78rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title); margin: 0;">Rango de Precio</h4>
                <div style="font-size: 0.75rem; color: var(--primary); font-weight: 700;">
                  <span id="mobile-price-min-val">0€</span> - <span id="mobile-price-max-val">Sin límite</span>
                </div>
              </div>
              <div class="double-slider-container">
                <div class="slider-track" id="mobile-slider-track"></div>
                <input type="range" id="mobile-price-min-slider" min="0" max="150" step="5" value="0" />
                <input type="range" id="mobile-price-max-slider" min="0" max="150" step="5" value="150" />
              </div>
            </div>

          <!-- CATEGORÍA Fijo Móvil (Multi-select) -->
          <div id="mobile-filter-main-categories-section" class="filter-section" style="margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--border-color);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
              <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title); margin: 0;">Categoría</h4>
            </div>
            <div id="mobile-sidebar-main-categories-list" style="display: flex; flex-direction: column; gap: 10px;">
              <!-- Inyectado dinámicamente con JS -->
            </div>
          </div>

          <!-- Subcategorías Dinámicas Móvil -->
          <div id="mobile-filter-subcategories-container"></div>

          <!-- Material (Solo visible cuando se selecciona dildos en móvil) -->
          <div id="mobile-filter-material-section" class="filter-section" style="margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--border-color); display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
              <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title);">Material</h4>
            </div>
            <div id="mobile-sidebar-materials-list" style="display: flex; flex-direction: column; gap: 10px;">
              <!-- Inyectado dinámicamente con JS -->
            </div>
          </div>

          <!-- Tipo de Estimulación (Solo visible para Juguetes > Succionadores y Estimuladores en móvil) -->
          <div id="mobile-filter-stimulation-section" class="filter-section" style="margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--border-color); display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
              <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title);">Tipo de Estimulación</h4>
            </div>
            <div id="mobile-sidebar-stimulation-list" style="display: flex; flex-direction: column; gap: 10px;">
              <!-- Inyectado dinámicamente con JS -->
            </div>
          </div>

          <!-- Contenedor dinámico de secciones de sub-subcategorías en móvil -->
          <div id="mobile-filter-characteristics-sections-container"></div>

          <!-- Marcas -->
          <div class="filter-section" style="margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
              <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-title);">Marca</h4>
            </div>
            <div id="mobile-sidebar-brands-list" style="display: flex; flex-direction: column; gap: 10px;">
              <!-- Inyectado dinámicamente con JS -->
            </div>
          </div>
        </div>
        <div class="mobile-filter-drawer-footer">
          <button id="apply-mobile-filters-btn" class="btn btn-primary" style="width: 100%; padding: 12px; border-radius: 50px; font-weight: 700; font-size: 0.95rem;">Aplicar Filtros</button>
        </div>
      </div>
    </div>

    <!-- Contenido principal -->
    <main style="flex: 1;">
      <slot />
    </main>

    <!-- Pie de página elegante -->
    {!hideHeaderFooter && (
