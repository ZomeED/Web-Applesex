---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <!-- SEO & Favicon Oficial AppleSex -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title ? `${title} | AppleSex` : "Tienda Online de Juguetes Eróticos - Applsex | AppleSex"}</title>
    <meta name="description" content={description || "Descubre Applesex, tu tienda online de juguetes eróticos con más de 10 años de experiencia. Explora nuestro amplio catálogo y encuentra los productos perfectos para ti. ¡Compra hoy y disfruta de una experiencia única!"} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#d60068" />
    <meta property="og:title" content={title ? `${title} | AppleSex` : "Tienda Online de Juguetes Eróticos - Applsex | AppleSex"} />
    <meta property="og:description" content={description || "Descubre Applesex, tu tienda online de juguetes eróticos con más de 10 años de experiencia. Explora nuestro amplio catálogo y encuentra los productos perfectos para ti. ¡Compra hoy y disfruta de una experiencia única!"} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
  </head>
  <body>
    <!-- Barra de Anuncios Superior Elegante y Descartable -->
    <div id="promo-announcement-bar" style="background: linear-gradient(90deg, #c43b7a, #ed6daa); color: white; padding: 8px 20px; font-size: 0.82rem; font-weight: 500; text-align: center; display: flex; align-items: center; justify-content: center; position: relative; z-index: 101; transition: var(--transition-smooth);">
      <span id="promo-text-content" style="flex-grow: 1; padding-right: 18px;">
        Inauguramos nuestra nueva web: <strong>20% de descuento</strong> en toda la tienda con el código <strong id="copy-promo-code" style="text-decoration: underline; color: #ffffff; cursor: pointer; padding: 2px 6px; border: 1px dashed #ffffff; border-radius: 4px; margin-left: 4px; display: inline-block;" title="Haz clic para copiar">APPLE20</strong>
      </span>
      <button id="close-promo-bar" style="background: transparent; border: none; color: white; cursor: pointer; font-size: 1.1rem; padding: 4px 8px; display: inline-flex; align-items: center; position: absolute; right: 10px;" aria-label="Cerrar aviso">
        ✕
      </button>
    </div>

    <!-- Encabezado con efecto cristal esmerilado -->
    <header class="glass main-header" style="position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--border-color);">
      <div class="container" style="display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 12px;">
        
        <div style="display: flex; align-items: center; gap: 12px;">
          <!-- Botón de Hamburguesa Móvil (Visible solo en móvil) -->
          <button id="mobile-hamburger-btn" class="hamburger-btn" aria-label="Abrir menú de navegación" aria-expanded="false">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
          
          <a href="/" id="header-logo-link" style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
            <img src="/logo.png" alt="AppleSex - Tienda Online de Juguetes Eróticos" style="height: 44px; width: auto; object-fit: contain; mix-blend-mode: multiply;" />
          </a>
        </div>

        <nav class="desktop-nav" style="display: flex; align-items: center; gap: 28px;">
          <a href="/#catalogo" id="nav-catalogo-link" style="font-size: 0.95rem; font-weight: 500; color: var(--text-secondary);">Catálogo</a>
          <a href="/#envios" id="nav-envios-link" style="font-size: 0.95rem; font-weight: 500; color: var(--text-secondary);">Envíos & Recogida</a>
          <a href="/#contacto" id="nav-contacto-link" style="font-size: 0.95rem; font-weight: 500; color: var(--text-secondary);">Contacto</a>
        </nav>

        <!-- Buscador Móvil y Desktop Integrado -->
        <div style="display: flex; align-items: center; gap: 8px;">
          <button id="open-search-modal-btn" class="search-trigger-btn" aria-label="Abrir buscador de productos">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="search-trigger-text">Buscar productos...</span>
            <span class="search-trigger-mobile-label">Buscar</span>
          </button>

          <!-- Widget del Carrito -->
          <a href="/carrito" id="header-cart-button" class="btn btn-secondary header-cart-btn" aria-label="Ver carrito">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span id="cart-counter" class="cart-counter-badge">0</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Modal de Búsqueda Flotante de Pantalla Completa (Mobile-First 100% Optimizado) -->
    <div id="search-modal-backdrop" class="search-backdrop" style="display: none;">
      <div class="search-modal-container">
        
        <!-- Input Principal de Búsqueda -->
        <div class="search-modal-header">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="modal-search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="modal-search-input" 
            placeholder="¿Qué estás buscando hoy?" 
            autocomplete="off"
            inputmode="search"
          />
          <button id="modal-clear-input" class="search-clear-btn" style="display: none;" title="Limpiar texto">✕</button>
          <button id="close-search-modal-btn" class="search-close-btn" aria-label="Cerrar buscador">Cerrar ✕</button>
        </div>

        <!-- Barra de Filtros Rápidos por Categoría (Scroll Táctil Suave) -->
        <div class="search-modal-categories" id="modal-category-filters">
          <button class="modal-cat-btn active" data-cat="all">Todas</button>
          <button class="modal-cat-btn" data-cat="JUGUETES">Juguetes</button>
          <button class="modal-cat-btn" data-cat="COSMÉTICA SENSORIAL">Cosmética Sensorial</button>
          <button class="modal-cat-btn" data-cat="BDSM">BDSM</button>
          <button class="modal-cat-btn" data-cat="SALUD ÍNTIMA">Salud Íntima</button>
        </div>

        <!-- Subcategorías Desplegables en el Buscador Modal con Transición Suave -->
        <div class="modal-subcategory-filter-wrapper" id="modal-subcategory-filter-wrapper">
          <div class="modal-subcategory-filter-chips" id="modal-subcategory-filter-chips"></div>
        </div>

        <!-- Búsquedas Populares -->
        <div id="modal-popular-searches" class="modal-popular-box">
          <span class="popular-title">Lo más buscado:</span>
          <div class="popular-tags-container">
            <button class="popular-tag-btn" data-query="vibrador">Vibradores</button>
            <button class="popular-tag-btn" data-query="aceite">Aceites de Masaje</button>
            <button class="popular-tag-btn" data-query="estimulador">Estimulador Clitoral</button>
            <button class="popular-tag-btn" data-query="plug">Plug Anal</button>
            <button class="popular-tag-btn" data-query="efecto calor">Efecto Calor</button>
            <button class="popular-tag-btn" data-query="shunga">Shunga</button>
          </div>
        </div>

        <!-- Resumen de Resultados -->
        <div id="modal-results-summary" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; border-bottom: 1px solid var(--border-color); font-size: 0.88rem; color: var(--text-secondary); background: #ffffff; flex-shrink: 0;">
          <span id="modal-results-count">Resultados: 0</span>
          <span style="font-weight: 500;">Relevancia</span>
        </div>

        <!-- Lista de Resultados de Productos -->
        <div class="search-results-wrapper">
          <div id="modal-results-grid" class="search-results-grid"></div>
        </div>

        <!-- Footer del Modal -->
        <div class="search-modal-footer">
          <span><strong id="modal-total-products">30</strong> productos disponibles</span>
          <span class="desktop-only-hint">Presiona <kbd>ESC</kbd> para salir</span>
        </div>

      </div>
    </div>

    <!-- Contenido principal -->
    <main style="flex: 1;">
      <slot />
    </main>

    <!-- Pie de página elegante -->
    <footer style="background-color: #ffffff; border-top: 1px solid var(--border-color); padding: 50px 0 30px 0;">
      <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px; margin-bottom: 30px;">
          <div>
            <a href="/" style="display: inline-block; margin-bottom: 14px;">
              <img src="/logo.png" alt="AppleSex" style="height: 38px; width: auto; object-fit: contain; mix-blend-mode: multiply;" />
            </a>
            <p style="color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 16px; line-height: 1.5;">
              Tu juguetería erótica y de bienestar íntimo de confianza en Churra, Murcia. Sexualidad sana, sana y divertida con envíos discretos.
            </p>
            <span style="color: var(--accent); font-weight: 600; font-size: 0.85rem;">📍 Av. de Alicante, Churra, Murcia</span>
          </div>

          <div>
            <h4 style="margin-bottom: 16px; font-size: 0.95rem; color: var(--accent);">Navegación</h4>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem; color: var(--text-secondary);">
              <li><a href="/#catalogo">Explorar Catálogo</a></li>
              <li><a href="/#envios">Envíos Discretos</a></li>
              <li><a href="/#recogida">Recogida Local (Click & Collect)</a></li>
              <li><a href="/politica-privacidad">Política de Privacidad</a></li>
            </ul>
          </div>

          <div id="contacto">
            <h4 style="margin-bottom: 16px; font-size: 0.95rem; color: var(--accent);">Contacto & Ayuda</h4>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem; color: var(--text-secondary);">
              <li>WhatsApp: <a href="https://wa.me/34600000000" target="_blank" style="color: var(--primary); font-weight: 600;">+34 600 00 00 00</a></li>
              <li>Email: info@applesex.es</li>
              <li>Horario: Lun - Sáb: 10:00 - 20:30</li>
            </ul>
          </div>
        </div>

        <div style="border-top: 1px solid var(--border-color); padding-top: 24px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; font-size: 0.78rem; color: var(--text-secondary);">
          <p>© {new Date().getFullYear()} Applesex. Todos los derechos reservados.</p>
          <div style="display: flex; gap: 12px;">
            <span>Tarjeta • Bizum • PayPal</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Menú de Navegación Lateral Móvil (Drawer) -->
    <div id="mobile-menu-drawer" class="mobile-drawer" style="display: none;">
      <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop"></div>
      <div class="mobile-drawer-content">
        <div class="mobile-drawer-header">
          <a href="/" style="display: flex; align-items: center; gap: 8px;">
            <img src="/logo.png" alt="AppleSex" style="height: 38px; width: auto; object-fit: contain; mix-blend-mode: multiply;" />
          </a>
          <button id="close-mobile-drawer-btn" class="drawer-close-btn" aria-label="Cerrar menú">✕</button>
        </div>
        
        <div class="mobile-drawer-body">
          <!-- Navegación Principal -->
          <nav class="mobile-drawer-nav">
            <a href="/" class="drawer-nav-item">Inicio</a>
            <a href="/#catalogo" class="drawer-nav-item drawer-close-on-click">Catálogo Completo</a>
            <a href="/#envios" class="drawer-nav-item drawer-close-on-click">Envíos & Recogida</a>
            <a href="/#contacto" class="drawer-nav-item drawer-close-on-click">Contacto</a>
          </nav>
          
          <!-- Separador -->
          <div class="drawer-divider"></div>
          
          <!-- Categorías Populares -->
          <div class="drawer-categories-section">
            <span class="drawer-section-title">Categorías</span>
            <div class="drawer-categories-list">
              
              <!-- 1. JUGUETES -->
              <div class="drawer-cat-group">
                <button class="drawer-cat-toggle" data-cat="JUGUETES">
                  <span style="display: flex; align-items: center; gap: 8px;">
                    <span class="cat-dot"></span> Juguetes
                  </span>
                  <svg class="drawer-cat-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="drawer-subcat-container">
                  <div class="drawer-subcat-list">
                    <a href="/?category=JUGUETES#catalogo" class="drawer-subcat-item" data-cat="JUGUETES" data-sub="all">Todos los artículos</a>
                    <a href="/?category=JUGUETES&subcategory=Vibradores#catalogo" class="drawer-subcat-item" data-cat="JUGUETES" data-sub="Vibradores">Vibradores</a>
                    <a href="/?category=JUGUETES&subcategory=Masculinos#catalogo" class="drawer-subcat-item" data-cat="JUGUETES" data-sub="Masculinos">Masculinos</a>
                    <a href="/?category=JUGUETES&subcategory=Anal#catalogo" class="drawer-subcat-item" data-cat="JUGUETES" data-sub="Anal">Anal</a>
                    <a href="/?category=JUGUETES&subcategory=Parejas#catalogo" class="drawer-subcat-item" data-cat="JUGUETES" data-sub="Parejas">Parejas</a>
                    <a href="/?category=JUGUETES&subcategory=Plugs#catalogo" class="drawer-subcat-item" data-cat="JUGUETES" data-sub="Plugs">Plugs</a>
                  </div>
                </div>
              </div>

              <!-- 2. COSMÉTICA SENSORIAL -->
              <div class="drawer-cat-group">
                <button class="drawer-cat-toggle" data-cat="COSMÉTICA SENSORIAL">
                  <span style="display: flex; align-items: center; gap: 8px;">
                    <span class="cat-dot"></span> Cosmética Sensorial
                  </span>
                  <svg class="drawer-cat-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="drawer-subcat-container">
                  <div class="drawer-subcat-list">
                    <a href="/?category=COSMÉTICA SENSORIAL#catalogo" class="drawer-subcat-item" data-cat="COSMÉTICA SENSORIAL" data-sub="all">Todos los artículos</a>
                    <a href="/?category=COSMÉTICA SENSORIAL&subcategory=Efecto Calor#catalogo" class="drawer-subcat-item" data-cat="COSMÉTICA SENSORIAL" data-sub="Efecto Calor">Efecto Calor</a>
                    <a href="/?category=COSMÉTICA SENSORIAL&subcategory=Aceites de Masaje#catalogo" class="drawer-subcat-item" data-cat="COSMÉTICA SENSORIAL" data-sub="Aceites de Masaje">Aceites de Masaje</a>
                    <a href="/?category=COSMÉTICA SENSORIAL&subcategory=Velas de Masaje#catalogo" class="drawer-subcat-item" data-cat="COSMÉTICA SENSORIAL" data-sub="Velas de Masaje">Velas de Masaje</a>
                  </div>
                </div>
              </div>

              <!-- 3. BDSM -->
              <div class="drawer-cat-group">
                <button class="drawer-cat-toggle" data-cat="BDSM">
                  <span style="display: flex; align-items: center; gap: 8px;">
                    <span class="cat-dot"></span> BDSM
                  </span>
                  <svg class="drawer-cat-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="drawer-subcat-container">
                  <div class="drawer-subcat-list">
                    <a href="/?category=BDSM#catalogo" class="drawer-subcat-item" data-cat="BDSM" data-sub="all">Todos los artículos</a>
                    <a href="/?category=BDSM&subcategory=Bondage#catalogo" class="drawer-subcat-item" data-cat="BDSM" data-sub="Bondage">Bondage y Accesorios</a>
                  </div>
                </div>
              </div>

              <!-- 4. SALUD ÍNTIMA -->
              <div class="drawer-cat-group">
                <button class="drawer-cat-toggle" data-cat="SALUD ÍNTIMA">
                  <span style="display: flex; align-items: center; gap: 8px;">
                    <span class="cat-dot"></span> Salud Íntima
                  </span>
                  <svg class="drawer-cat-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="drawer-subcat-container">
                  <div class="drawer-subcat-list">
                    <a href="/?category=SALUD ÍNTIMA#catalogo" class="drawer-subcat-item" data-cat="SALUD ÍNTIMA" data-sub="all">Todos los artículos</a>
                    <a href="/?category=SALUD ÍNTIMA&subcategory=Cuidado Natural#catalogo" class="drawer-subcat-item" data-cat="SALUD ÍNTIMA" data-sub="Cuidado Natural">Cuidado Natural</a>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Separador -->
          <div class="drawer-divider"></div>
          
          <!-- Información y Redes -->
          <div class="drawer-info-section">
            <span class="drawer-section-title">¿Necesitas ayuda?</span>
            <a href="https://wa.me/34600000000" target="_blank" class="drawer-whatsapp-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              Preguntar por WhatsApp
            </a>
            <div class="drawer-store-hours">
              <p>📍 Av. de Alicante, Churra, Murcia</p>
              <p>🕒 Lun - Sáb: 10:00 - 20:30</p>
              <p>📧 info@applesex.es</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Estilos del Buscador Profesional Mobile-First -->
    <style is:global>
      /* Header principal */
      .main-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
      }

      .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
        gap: 16px;
      }

      .header-cart-btn {
        padding: 8px 14px;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        min-height: 40px;
        background: #ffffff;
        border: 1px solid var(--border-color);
        color: var(--text-primary);
      }
      .header-cart-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: #fcf0f5;
      }
      .cart-counter-badge {
        background: var(--primary);
        color: white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
      }

      /* Botón disparador del buscador en Header */
      .search-trigger-btn {
        background: #f2eff6;
        border: 1px solid var(--border-color);
        color: var(--text-secondary);
        padding: 8px 16px;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.25s ease;
        width: 220px;
        min-height: 40px;
      }
      .search-trigger-btn:hover, .search-trigger-btn:active {
        background: #ffffff;
        border-color: var(--primary);
        color: var(--text-primary);
        box-shadow: 0 0 15px rgba(216, 75, 140, 0.2);
      }

      .search-trigger-text {
        flex-grow: 1;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .search-trigger-mobile-label {
        display: none;
      }

      @media (max-width: 768px) {
        .desktop-nav {
          display: none !important;
        }
        .search-trigger-btn {
          width: auto;
          padding: 8px 14px;
          background: rgba(216, 75, 140, 0.1);
          border-color: rgba(216, 75, 140, 0.3);
          color: var(--text-primary);
        }
        .search-trigger-text {
          display: none;
        }
        .search-trigger-mobile-label {
          display: inline;
          font-size: 0.85rem;
          font-weight: 600;
        }
        .desktop-only-hint {
          display: none !important;
        }
      }

      /* Botón de Hamburguesa */
      .hamburger-btn {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 22px;
        height: 16px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 1002; /* Por encima del header */
        flex-shrink: 0;
      }
      .hamburger-line {
        width: 100%;
        height: 2px;
        background-color: var(--text-primary);
        border-radius: 4px;
        transition: all 0.25s ease-in-out;
      }
      .hamburger-btn.open .hamburger-line:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
        background-color: var(--primary);
      }
      .hamburger-btn.open .hamburger-line:nth-child(2) {
        opacity: 0;
        transform: translateX(-10px);
      }
      .hamburger-btn.open .hamburger-line:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
        background-color: var(--primary);
      }

