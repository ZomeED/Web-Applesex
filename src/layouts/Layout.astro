                ${mobileOptionsHtml || '<p style="font-size: 0.8rem; color: var(--text-secondary); font-style: italic;">Sin filtros disponibles</p>'}
              </div>
            </div>
          `;
        });

        // 3. Inyectar HTML y enlazar listeners con preservación del foco
        withFocusPreservation(() => {
          if (categoriesList) categoriesList.innerHTML = mainCatsHtml;
          if (mobileCategoriesList) mobileCategoriesList.innerHTML = mainCatsHtml;
          if (subcategoriesContainer) subcategoriesContainer.innerHTML = subCatsHtml;
          if (mobileSubcategoriesContainer) mobileSubcategoriesContainer.innerHTML = mobileSubCatsHtml;

          // A. Listener para los checkboxes de Categoría Principal (Multi-select)
          document.querySelectorAll('.sidebar-main-cat-checkbox').forEach(cb => {
            cb.addEventListener('change', (e) => {
              const target = e.target as HTMLInputElement;
              const val = target.value;
              
              if (target.checked) {
                if (!selectedCategories.includes(val)) {
                  selectedCategories.push(val);
                }
              } else {
                selectedCategories = selectedCategories.filter(x => x !== val);
                // Si desmarcamos una categoría principal, limpiamos todas sus subcategorías seleccionadas de fondo
                if (subcategoriesData[val]) {
                  selectedSubcategories = selectedSubcategories.filter(sub => !subcategoriesData[val].includes(sub));
                }
              }

              // Sincronizar todos los checkboxes con el mismo valor (desktop/mobile)
              document.querySelectorAll(`.sidebar-main-cat-checkbox[value="${val}"]`).forEach(el => {
                (el as HTMLInputElement).checked = target.checked;
              });

              // Sincronizar activeCategory (si solo hay 1 seleccionada, para pintar el chip superior activo)
              if (selectedCategories.length === 1) {
                activeCategory = selectedCategories[0];
              } else {
                activeCategory = 'all';
              }
              
              // Actualizar UI del buscador
              updateTopChipsActiveState();
              updateModalSubcategoriesUI();
              renderSidebarFilters();
              renderSidebarMaterialsAndCharacteristics();
              renderSidebarStimulation();
              renderSearchResults();
