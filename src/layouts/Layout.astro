          if (name.includes('babydoll') || name.includes('corset') || name.includes('tanga') || name.includes('teddy') || name.includes('medias') || name.includes('peignoir') || name.includes('lencería') || name.includes('lingerie') || name.includes('liguero') || name.includes('bodystocking') || name.includes('bodystockin') || name.includes('body con') || desc.includes('lencería penthouse') || desc.includes('colección penthouse') || name.includes('pezoneras') || name.includes('body crotchless')) {
            return 'Lencería';
          }
          if (name.includes('plug')) return 'Plugs';
          if (name.includes('beads') || name.includes('anal') || name.includes('bolas anales')) return 'Anal';
          if (name.includes('pareja') || name.includes('doble')) return 'Parejas';
          if (name.includes('masculino') || name.includes('hombre') || name.includes('pene') || name.includes('perineal') || name.includes('próstata')) return 'Masculinos';
          return 'Vibradores';
        }
        if (cat.includes('COSMÉTICA') || cat.includes('COSMETICA') || cat.includes('SENSORIAL')) {
          if (name.includes('calor') || desc.includes('calor')) return 'Efecto Calor';
          if (name.includes('vela')) return 'Velas de Masaje';
          return 'Aceites de Masaje';
        }
        if (cat.includes('BDSM')) {
          return 'Bondage';
        }
        if (cat.includes('SALUD') || cat.includes('BIENESTAR') || cat.includes('ÍNTIMA') || cat.includes('INTIMA')) {
          return 'Cuidado Natural';
        }
        return 'Otros';
      }

      function getProductBrand(product) {
        if (product && product.brand) return product.brand;
        const name = (product.name || '').toLowerCase();
        const desc = (product.description || '').toLowerCase();
        const slug = (product.slug || '').toLowerCase();

        const hasBrandWord = (text, brand) => {
          const regex = new RegExp('\\b' + brand + '\\b', 'i');
          return regex.test(text);
        };

        if (hasBrandWord(name, 'satisfyer') || hasBrandWord(desc, 'satisfyer')) return 'Satisfyer';
        if (hasBrandWord(name, 'lelo') || hasBrandWord(desc, 'lelo') || slug.includes('lelo')) return 'Lelo';
        if (hasBrandWord(name, 'shunga') || hasBrandWord(desc, 'shunga') || slug.includes('shunga')) return 'Shunga';
        if (hasBrandWord(name, 'silexd') || hasBrandWord(desc, 'silexd') || hasBrandWord(name, 'silexpan') || hasBrandWord(desc, 'silexpan') || slug.includes('silexd') || slug.includes('silexpan')) return 'SilexD';
        
        return 'Otros';
      }

      // Algoritmo de distancia de Levenshtein para tolerancia a erratas
      function levenshtein(a, b) {
        const matrix = [];
        for (let i = 0; i <= b.length; i++) matrix[i] = [i];
        for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
        for (let i = 1; i <= b.length; i++) {
          for (let j = 1; j <= a.length; j++) {
            if (b.charAt(i - 1) === a.charAt(j - 1)) {
              matrix[i][j] = matrix[i - 1][j - 1];
            } else {
              matrix[i][j] = Math.min(
                matrix[i - 1][j - 1] + 1,
                matrix[i][j - 1] + 1,
                matrix[i - 1][j] + 1
              );
            }
          }
        }
        return matrix[b.length][a.length];
      }

      function includesWholeWord(text, word) {
        const escapedWord = word.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
        const regex = new RegExp('(?:^|[^a-záéíóúüñ])' + escapedWord + 's?(?:$|[^a-záéíóúüñ])', 'i');
        return regex.test(text);
      }

      // Comprobar coincidencia fuzzy
      function matchProductFuzzy(product, query) {
        if (!query) return true;
        const queryWords = query.toLowerCase().split(/\s+/).filter(w => w.length >= 2);
        if (queryWords.length === 0) return true;
        
        const synonyms = {
          "product-limpiador-anal-negro": ["pera", "enema", "ducha anal", "irrigador", "limpiador anal", "limpiado anal"]
        };
        
        const stopWords = ['de', 'la', 'en', 'para', 'con', 'por', 'una', 'del', 'como', 'las', 'los', 'un', 'unos', 'unas', 'y', 'o', 'este', 'esta', 'todo', 'todos'];
        
        const subcategory = getProductSubcategory(product);
        const name = (product.name || '').toLowerCase();
        const description = (product.description || '').toLowerCase();
        const category = (product.category || '').toLowerCase();
        const tags = (synonyms[product.id] || []).join(' ');
        
        const primaryFields = [name, category, subcategory, tags].join(' ').toLowerCase();
        const primaryWords = primaryFields.split(/[\s,.:;?!()""']+/).filter(w => w.length >= 2);

        return queryWords.every(qw => {
          const matchPrimary = primaryWords.some(pw => {
            if (pw.includes(qw)) return true;
            if (qw.length < 4) return pw === qw;
            if (stopWords.includes(pw) || stopWords.includes(qw)) return false;
            const maxEdits = qw.length <= 6 ? 1 : 2;
            return levenshtein(qw, pw) <= maxEdits;
          });
          if (matchPrimary) return true;
          
          const isCategoryQuery = ['lencería', 'lenceria', 'juguete', 'juguetes', 'cosmética', 'cosmetica', 'bdsm', 'salud', 'bienestar'].includes(qw);
          if (isCategoryQuery) return false;
          
          return includesWholeWord(description, qw);
        });
      }

      // Resaltar coincidencias de forma inteligente
      function highlightText(text, query) {
        if (!query) return text;
        const queryWords = query.toLowerCase().split(/\s+/).filter(w => w.length >= 2);
        if (queryWords.length === 0) return text;

        const textWords = text.split(/(\s+)/);
        
        const highlightedWords = textWords.map(part => {
          if (/^\s+$/.test(part)) return part;
          const cleanWord = part.toLowerCase().replace(/[,.:;?!()""']/g, '');
          
          const matches = queryWords.some(qw => {
            if (cleanWord.includes(qw)) return true;
            if (qw.length < 4) return cleanWord === qw;
            const maxEdits = qw.length <= 6 ? 1 : 2;
            return levenshtein(qw, cleanWord) <= maxEdits;
          });

          if (matches) {
            return `<mark class="search-highlight">${part}</mark>`;
          }
          return part;
        });

        return highlightedWords.join('');
      }

