      // Renderizar los filtros del sidebar lateral (Desktop + Mobile)
      // Helper to preserve focus
      function withFocusPreservation(callback) {
        const activeEl = document.activeElement as HTMLInputElement;
        const value = activeEl && (activeEl.tagName === 'INPUT' ? activeEl.value : activeEl.getAttribute('data-subcat') || activeEl.getAttribute('data-cat'));
        const className = activeEl && activeEl.className;
        const tagName = activeEl && activeEl.tagName;

        callback();

        if (activeEl && className && tagName) {
          const classSelector = className.split(/\s+/).filter(Boolean).map(c => '.' + c).join('');
          let newEl = null;
          if (tagName === 'INPUT') {
            newEl = document.querySelector(`input${classSelector}[value="${value}"]`);
          } else if (tagName === 'BUTTON') {
            newEl = document.querySelector(`button${classSelector}[data-subcat="${value}"], button${classSelector}[data-cat="${value}"]`);
          }
          if (newEl) (newEl as HTMLElement).focus();
        }
      }

      // Helper function to check if product matches current filters
      function productMatchesFilters(p, query, options = {}) {
        // 1. Category (multi-select check list or top chip shortcut)
        let matchCat = true;
        if (!options.excludeCategory && selectedCategories.length > 0) {
          matchCat = selectedCategories.map(c => c.toUpperCase()).includes(p.category.toUpperCase());
        }
        if (!matchCat) return false;

        // 2. Subcategory (top category chip and sidebar category checklist)
        if (!options.excludeSubcategory) {
          const matchSubcat = activeSubcategory === 'all' || p.subcategory === activeSubcategory || p.subcategory2 === activeSubcategory;
          if (!matchSubcat) return false;

          if (selectedSubcategories.length > 0) {
            const sub1 = p.subcategory || null;
            const sub2 = p.subcategory2 || null;
            const hasMatch = selectedSubcategories.includes(sub1) || (sub2 && selectedSubcategories.includes(sub2));
            if (!hasMatch) return false;
          }
        }

        // 3. Sub-subcategory quick chip
        if (!options.excludeSubSubcategory && activeSubSubCategory !== 'all') {
          const subcatKey = SUB_SUBCATEGORIES_MAP[activeSubcategory]
            ? activeSubcategory
            : selectedSubcategories.find(sub => SUB_SUBCATEGORIES_MAP[sub]);
          if (!productMatchesSubSub(p, subcatKey, activeSubSubCategory)) return false;
        }

        // 4. Characteristics (checkboxes)
        if (!options.excludeCharacteristics && selectedCharacteristics.length > 0) {
          const pSub1 = p.subcategory || 'Vibradores';
          const pSub2 = p.subcategory2 || null;

          const pSub1SelectedChars = selectedCharacteristics.filter(c => {
            const subMap = SUB_SUBCATEGORIES_MAP[pSub1];
            return subMap && subMap.options.includes(c);
          });
          const pSub2SelectedChars = pSub2 ? selectedCharacteristics.filter(c => {
            const subMap = SUB_SUBCATEGORIES_MAP[pSub2];
            return subMap && subMap.options.includes(c);
          }) : [];

          const totalSelectedChars = [...pSub1SelectedChars, ...pSub2SelectedChars];
          if (totalSelectedChars.length > 0) {
            const matchesAny = totalSelectedChars.some(c => {
              if (pSub1SelectedChars.includes(c) && productMatchesSubSub(p, pSub1, c)) return true;
              if (pSub2 && pSub2SelectedChars.includes(c) && productMatchesSubSub(p, pSub2, c)) return true;
              return false;
            });
            if (!matchesAny) return false;
          }
        }

        // 5. Stimulation
        if (!options.excludeStimulation && selectedStimulations.length > 0) {
          const stim = getProductStimulationType(p);
          if (!selectedStimulations.includes(stim)) return false;
        }

        // 6. Brand
        if (!options.excludeBrand && selectedBrands.length > 0) {
          const brand = getProductBrand(p);
          if (!selectedBrands.includes(brand)) return false;
        }

        // 7. Price
        if (!options.excludePrice) {
          const price = parseFloat(p.price) || 0;
          if (price < activeMinPrice || (activeMaxPrice < 150 && price > activeMaxPrice)) return false;
        }

        // 8. Fuzzy query
        return matchProductFuzzy(p, query);
      }

      function updateTopChipsActiveState() {
        document.querySelectorAll('.modal-cat-btn').forEach(btn => {
          const cat = btn.getAttribute('data-cat') || 'all';
          if (cat === 'all') {
            if (selectedCategories.length === 0) {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          } else {
            if (selectedCategories.length === 1 && selectedCategories[0].toUpperCase() === cat.toUpperCase()) {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          }
        });
      }

      function renderSidebarFilters() {
        const query = searchInput ? searchInput.value.trim().toLowerCase() : '';

        // 1. Renderizar Categorías Principales Fijas (Desktop + Mobile)
        const mainCategoryLabels = {
          "JUGUETES": "Juguetes",
          "LENCERÍA": "Lencería",
          "ANAL": "Anal",
          "COSMÉTICA": "Cosmética",
          "BDSM": "BDSM",
          "BIENESTAR": "Bienestar"
        };
        const mainCategoryKeys = ["JUGUETES", "LENCERÍA", "ANAL", "COSMÉTICA", "BDSM", "BIENESTAR"];
        
        let mainCatsHtml = '';
        mainCategoryKeys.forEach(cat => {
          const count = allProducts.filter(p => {
            const matchesOtherFilters = productMatchesFilters(p, query, { excludeCategory: true });
            return matchesOtherFilters && p.category.toUpperCase() === cat.toUpperCase();
          }).length;
          
          const isChecked = selectedCategories.includes(cat);
          const label = mainCategoryLabels[cat] || cat;
          
          mainCatsHtml += `
