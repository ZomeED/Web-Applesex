                 <span>${label}</span>
               </span>
               <span style="font-size: 0.75rem; color: var(--text-secondary); opacity: 0.7;">(${count})</span>
            </label>
          `;
        });

        // 2. Renderizar Subcategorías Dinámicas de las categorías seleccionadas
        let subCatsHtml = '';
        let mobileSubCatsHtml = '';
        
        selectedCategories.forEach(cat => {
          const subCats = subcategoriesData[cat] || [];
          let desktopOptionsHtml = '';
          let mobileOptionsHtml = '';
          
          subCats.forEach(sub => {
            const count = allProducts.filter(p => {
              const matchesOtherFilters = productMatchesFilters(p, query, { excludeSubcategory: true });
              const matchesSub = p.subcategory === sub || p.subcategory2 === sub;
              return matchesOtherFilters && matchesSub;
            }).length;
            
            const isChecked = selectedSubcategories.includes(sub);
            
            const checkboxHtml = `
              <label style="display: flex; align-items: center; justify-content: space-between; font-size: 0.78rem; color: var(--text-secondary); cursor: pointer; user-select: none; margin-bottom: 2px;">
                 <span style="display: flex; align-items: center; gap: 6px;">
                   <input type="checkbox" class="sidebar-subcat-checkbox" value="${sub}" ${isChecked ? 'checked' : ''} style="width: 14px; height: 14px; accent-color: var(--primary); cursor: pointer;" />
                   <span>${sub}</span>
                 </span>
                 <span style="font-size: 0.75rem; color: var(--text-secondary); opacity: 0.7;">(${count})</span>
              </label>
            `;
            desktopOptionsHtml += checkboxHtml;
            mobileOptionsHtml += checkboxHtml;
          });
          
          const title = mainCategoryLabels[cat] || cat;
          
          // Desktop subcategory block
          subCatsHtml += `
            <div class="filter-section dynamic-subcat-section" data-cat="${cat}" style="margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
