    avatarUrl: "https://lh3.googleusercontent.com/a/ACg8ocJn6G4sUm4Ji1XRBIRMrcm6gEJj86SFkth_DrNhj1cmTp5Zxw=w36-h36-p-rp-mo-ba12-br100",
    status: "★ Local Guide",
    text: '"Me encanta esta tienda porque te asesoran muy bien y siempre encuentro lo que busco"',
    date: "Hace 1 año",
    featured: false
  },
  {
    name: "Emilio J. González",
    initials: "EG",
    avatarClass: "avatar-eg",
    avatarUrl: "https://lh3.googleusercontent.com/a-/ALV-UjXNnnllbUK1xwcjDzel6I6F8KH0k1_kqVIs7kaec3kFcZka3dVA=w36-h36-p-rp-mo-br100",
    status: "★ Local Guide",
    text: '"El trato personal inmejorable. Te aconsejan, te sugieren y te ayudan en la compra. La gerente es de lo más profesional que te puedes encontrar. Me lo recomendaron y lo recomendaré, un 10."',
    date: "Hace 1 año",
    featured: false
  },
  {
    name: "Clara Espinosa",
    initials: "CE",
    avatarClass: "avatar-ce",
    avatarUrl: "https://lh3.googleusercontent.com/a/ACg8ocK0i56RcF2RB9wUepRQAjigWgGe_S1oR2HOih0OZGLRKd0cmg=w36-h36-p-rp-mo-ba12-br100",
