    avatarUrl: "https://lh3.googleusercontent.com/a-/ALV-UjUjsnpbzJvHyVJIEk1U9gRoj3M_YAfWnLmPv5TMiVz8JNEDDbyR=s64-c-rp-mo-br100",
    status: "✓ Cliente verificado",
